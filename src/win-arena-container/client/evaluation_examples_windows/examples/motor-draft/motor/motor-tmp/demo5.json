{
  "id": "chrome-sydney-weather-bookmark",
  "snapshot": "chrome",
  "instruction": "Open Google Chrome, enable the on-screen keyboard, navigate to Google, search for 'Sydney weather', and bookmark the search results page.",
  "source": "human",
  "config": [
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    }
  ],
  "trajectory": "trajectories/",
  "related_apps": [
    "chrome"
  ],
  "evaluator": {
    "func": "check_chrome_weather_bookmark"
  },
  "proxy": true,
  "fixed_ip": false,
  "possibility_of_env_change": "low"
}