{
  "id": "linux-left-handed-mouse-drag-file",
  "snapshot": "linux",
  "instruction": "Enable Left-Handed Mouse mode in Linux Accessibility or Mouse Settings. Then drag the file test_file.txt from the Desktop into the Documents folder.",
  "source": "human",
  "config": [
    {
      "type": "execute",
      "parameters": {
        "command": [
          "bash",
          "-c",
          "mkdir -p ~/Desktop ~/Documents && echo 'test file for drag task' > ~/Desktop/test_file.txt"
        ]
      }
    }
  ],
  "trajectory": "trajectories/",
  "related_apps": [
    "settings",
    "files"
  ],
  "evaluator": {
    "func": "check_file_moved",
    "result": {
      "type": "vm_command_line",
      "command": "ls ~/Documents && echo '===SPLIT===' && ls ~/Desktop",
      "shell": true
    },
    "expected": {
      "type": "rule",
      "rules": {
        "file": "test_file.txt"
      }
    }
  },
  "proxy": false,
  "fixed_ip": false,
  "possibility_of_env_change": "low"
}