{
  "id": "bendigo-personal-demo-transfer-food",
  "snapshot": "chrome",
  "instruction": "Using On-Screen Keyboard, open Chrome and go to the Bendigo Bank interactive e-banking demo. Choose \"Launch Personal Demo\". Transfer $10 from \"Demo Everyday Account\" to \"Demo Multi Signatory Account\". Add \"Food\" as the description and send the transfer now. After the confirmation page appears, take a screenshot and save it to the Desktop as bendigo_transfer.png.",
  "source": "human",
  "config": [
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--user-data-dir=/tmp/chrome-bendigo-demo",
          "https://demo.bendigobank.com.au/banking/sign_in"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    }
  ],
  "trajectory": "trajectories/",
  "related_apps": ["chrome"],
  "evaluator": {
    "func": "check_include_exclude",
    "result": {
      "type": "vm_command_line",
      "command": "cmd /c dir C:\\Users\\Docker\\Desktop",
      "shell": true
    },
    "expected": {
      "type": "rule",
      "rules": {
        "include": ["bendigo_transfer.png"],
        "exclude": []
      }
    }
  },
  "proxy": true,
  "fixed_ip": false,
  "possibility_of_env_change": "medium"
}