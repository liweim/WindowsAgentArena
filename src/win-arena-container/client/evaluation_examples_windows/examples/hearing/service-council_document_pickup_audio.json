{
  "id": "service-council_document_pickup_audio",
  "category": "service",
  "need_ids": [
    "H1"
  ],
  "difficulty": "medium",
  "instruction": "Turn on Windows Live captions and use them to read the council service recording on the Desktop. Save the pickup location, collection hours, item to bring, and reference number to `answer.txt`, one item per line.",
  "source": "synthetic",
  "transcript": "Council service update. Your parking permit documents are ready for pickup at the Civic Service Centre, counter 4. Collection hours are 9:00 AM to 4:30 PM. Bring photo ID. Reference number PS-482.",
  "gt_steps": [
    "Turn on Windows Live captions.",
    "Play `CouncilPickupAudio.mp3` in Chrome with Windows Live captions running.",
    "Open Notepad.",
    "Enter `Civic Service Centre, counter 4\\n9:00 AM-4:30 PM\\nPhoto ID\\nPS-482`, one item per line.",
    "Save the file as `answer.txt` on the Desktop.",
    "Leave Windows Live captions running."
  ],
  "config": [
    {
      "type": "upload_file",
      "parameters": {
        "files": [
          {
            "local_path": "assets/service-council_document_pickup_audio.mp3",
            "path": "C:\\Users\\Docker\\Desktop\\CouncilPickupAudio.mp3"
          }
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    },
    {
      "type": "sleep",
      "parameters": {
        "seconds": 1
      }
    },
    {
      "type": "chrome_open_tabs",
      "parameters": {
        "urls_to_open": [
          "file:///C:/Users/Docker/Desktop/CouncilPickupAudio.mp3"
        ]
      }
    },
    {
      "type": "activate_window",
      "parameters": {
        "window_name": "Google Chrome"
      }
    }
  ],
  "related_apps": [
    "settings",
    "chrome",
    "notepad"
  ],
  "evaluator": {
    "func": [
      "check_include_exclude",
      "check_text_points"
    ],
    "conj": "and",
    "result": [
      {
        "type": "vm_command_line",
        "command": [
          "powershell",
          "-NoProfile",
          "-Command",
          "$found = Get-Process | Where-Object { $_.ProcessName -match 'LiveCaptions|LiveCaption' -or $_.MainWindowTitle -match 'Live captions|Live Caption' }; if ($found) { 'WINDOWS_LIVE_CAPTIONS_RUNNING' } else { 'WINDOWS_LIVE_CAPTIONS_NOT_RUNNING' }"
        ]
      },
      {
        "type": "desktop_file_text",
        "filename": "answer.txt"
      }
    ],
    "expected": [
      {
        "type": "rule",
        "rules": {
          "include": [
            "WINDOWS_LIVE_CAPTIONS_RUNNING"
          ],
          "exclude": [
            "WINDOWS_LIVE_CAPTIONS_NOT_RUNNING"
          ]
        }
      },
      {
        "type": "rule",
        "rules": {
          "ignore_case": true,
          "ordered": true,
          "line_based": true,
          "points": [
            {
              "all_of": [
                [
                  "Civic Service Centre",
                  "Civic Service Center"
                ],
                [
                  "counter 4",
                  "counter four"
                ]
              ]
            },
            {
              "regex": [
                "\\b9(?::00)?\\s*(?:am)?\\s*(?:-|to)\\s*4:30\\s*pm\\b"
              ]
            },
            [
              "Photo ID",
              "photo identification"
            ],
            [
              "PS-482",
              "PS 482"
            ]
          ]
        }
      }
    ]
  },
  "proxy": false,
  "possibility_of_env_change": "low"
}
