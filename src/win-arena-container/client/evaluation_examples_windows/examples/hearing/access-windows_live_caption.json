{
  "id": "access-windows_live_caption",
  "user_group": "hearing",
  "subgroup_ids": [
    "H-S1"
  ],
  "category": "access",
  "need_ids": [
    "H1",
    "H2"
  ],
  "difficulty": "easy",
  "operation_time": 50.56,
  "instruction": "I rely on text for spoken content and need larger captions to read them comfortably. Turn on Windows Live captions, set the caption style to Large text, and leave it enabled.",
  "source": "synthetic",
  "gt_steps": [
    "Open Windows Settings to Accessibility > Captions.",
    "Turn on Live captions.",
    "Set Caption style to Large text.",
    "Wait for the initial configuration."
  ],
  "config": [],
  "related_apps": [
    "settings"
  ],
  "evaluator": {
    "func": [
      "check_include_exclude",
      "exact_match"
    ],
    "conj": "and",
    "result": [
      {
        "type": "vm_command_line",
        "command": [
          "powershell",
          "-NoProfile",
          "-Command",
          "$found = Get-Process | Where-Object { $_.ProcessName -match 'LiveCaptions|LiveCaption' -or $_.MainWindowTitle -match 'Live captions|Live Caption' }; if ($found) { 'windows_live_caption_enabled' }"
        ]
      },
      {
        "type": "selected_caption_style_name"
      }
    ],
    "expected": [
      {
        "type": "rule",
        "rules": {
          "include": [
            "windows_live_caption_enabled"
          ]
        }
      },
      {
        "type": "rule",
        "rules": {
          "expected": "Large text"
        }
      }
    ],
    "metric_roles": {
      "task_outcome": [
        0,
        1
      ],
      "access_requirement": [
        0,
        1
      ]
    }
  },
  "proxy": false,
  "possibility_of_env_change": "low"
}
