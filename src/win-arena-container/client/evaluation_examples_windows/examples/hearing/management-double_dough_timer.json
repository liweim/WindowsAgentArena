{
  "id": "management-double_dough_timer",
  "snapshot": "chrome",
  "category": "management",
  "difficulty": "medium",
  "instruction": "Turn on captions in the opened YouTube video, determine about how long the pita dough should take to double in size, then use https://vclock.com to create a timer for that duration. Leave the timer visible in the browser.",
  "source": "https://www.youtube.com/watch?v=NPiA69p4gqE",
  "gt_steps": [
    "Turn on captions in the YouTube player.",
    "Watch the YouTube video and use the YouTube captions to determine that the pita dough should take 2h to double in size.",
    "Open https://vclock.com in the browser.",
    "Click the Timer page.",
    "Create and start a 2h timer.",
    "Leave the timer visible in the browser."
  ],
  "config": [
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    },
    {
      "type": "chrome_prepare_youtube_for_live_caption",
      "parameters": {
        "url": "https://www.youtube.com/watch?v=NPiA69p4gqE",
        "wait_seconds": 1
      }
    },
    {
      "type": "activate_window",
      "parameters": {
        "window_name": "Google Chrome"
      }
    }
  ],
  "trajectory": "trajectories\\",
  "related_apps": [
    "chrome"
  ],
  "evaluator": {
    "func": [
      "is_expected_url_pattern_match",
      "exact_match"
    ],
    "conj": "and",
    "result": [
      {
        "type": "active_tab_info_simple"
      },
      {
        "type": "youtube_captions_enabled",
        "url": "https://www.youtube.com/watch?v=NPiA69p4gqE"
      }
    ],
    "expected": [
      {
        "type": "rule",
        "rules": {
          "expected": [
            "https?://(www\\.)?vclock\\.com/timer/#countdown=02:00:00(&|$)"
          ]
        }
      },
      {
        "type": "rule",
        "rules": {
          "expected": "true"
        }
      }
    ]
  }
}
