{
  "id": "management-home_delivery_window_audio",
  "user_group": "hearing",
  "subgroup_ids": [
    "H-S1"
  ],
  "category": "management",
  "need_ids": [
    "H1"
  ],
  "difficulty": "medium",
  "instruction": "Use Chrome Live Caption to read the delivery reminder on the Desktop. Create a Sticky Note containing the delivery date, arrival window, preparation instruction, and delivery reference.",
  "source": "synthetic",
  "transcript": "Delivery reminder. Your mobility equipment delivery is scheduled for Thursday, September 24, 2026. The arrival window is 1:20 PM to 2:10 PM. Keep the side gate clear. Delivery reference DL-731.",
  "gt_steps": [
    "Turn on Chrome Live Caption.",
    "Play `HomeDeliveryAudio.mp3` in Chrome with Live Caption enabled.",
    "Create a new note in Sticky Notes.",
    "Enter `Delivery date: 24 September 2026\\nArrival window: 1:20 PM-2:10 PM\\nKeep the side gate clear\\nReference: DL-731` into the note.",
    "Keep the completed note saved.",
    "Leave Chrome Live Caption enabled."
  ],
  "config": [
    {
      "type": "upload_file",
      "parameters": {
        "files": [
          {
            "local_path": "assets/management-home_delivery_window_audio.mp3",
            "path": "C:\\Users\\Docker\\Desktop\\HomeDeliveryAudio.mp3"
          }
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    },
    {
      "type": "sleep",
      "parameters": {
        "seconds": 1
      }
    },
    {
      "type": "chrome_open_tabs",
      "parameters": {
        "urls_to_open": [
          "file:///C:/Users/Docker/Desktop/HomeDeliveryAudio.mp3"
        ]
      }
    },
    {
      "type": "activate_window",
      "parameters": {
        "window_name": "Google Chrome"
      }
    },
    {
      "type": "execute",
      "parameters": {
        "command": [
          "powershell",
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "Start-Process 'shell:AppsFolder\\Microsoft.MicrosoftStickyNotes_8wekyb3d8bbwe!App'"
        ]
      }
    }
  ],
  "related_apps": [
    "chrome",
    "sticky_notes"
  ],
  "evaluator": {
    "func": [
      "check_text_points",
      "exact_match"
    ],
    "conj": "and",
    "result": [
      {
        "type": "sticky_notes_content"
      },
      {
        "type": "live_caption_enabled"
      }
    ],
    "expected": [
      {
        "type": "rule",
        "rules": {
          "ignore_case": true,
          "points": [
            [
              "24 September 2026",
              "September 24, 2026"
            ],
            [
              "1:20 PM",
              "1:20"
            ],
            [
              "2:10 PM",
              "2:10"
            ],
            [
              "side gate"
            ],
            [
              "DL-731",
              "DL 731"
            ]
          ]
        }
      },
      {
        "type": "rule",
        "rules": {
          "expected": "true"
        }
      }
    ]
  },
  "proxy": false,
  "possibility_of_env_change": "low"
}
