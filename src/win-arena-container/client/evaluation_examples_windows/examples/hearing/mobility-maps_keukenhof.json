{
  "id": "mobility-maps_keukenhof",
  "snapshot": "chrome",
  "category": "mobility",
  "difficulty": "easy",
  "instruction": "Turn on captions in the opened YouTube video, identify the garden shown there, then open its location in Google Maps.",
  "source": "https://www.youtube.com/watch?v=EnnurXLooZw",
  "gt_steps": [
    "Turn on captions in the YouTube player.",
    "Watch the YouTube video and identify `Keukenhof` from the YouTube captions.",
    "Open Google Maps.",
    "Search for `Keukenhof`."
  ],
  "config": [
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    },
    {
      "type": "chrome_prepare_youtube_for_live_caption",
      "parameters": {
        "url": "https://www.youtube.com/watch?v=EnnurXLooZw",
        "wait_seconds": 1
      }
    },
    {
      "type": "activate_window",
      "parameters": {
        "window_name": "Google Chrome"
      }
    }
  ],
  "trajectory": "trajectories\\",
  "related_apps": [
    "chrome"
  ],
  "evaluator": {
    "func": [
      "exact_match",
      "exact_match"
    ],
    "conj": "and",
    "result": [
      {
        "type": "youtube_captions_enabled",
        "url": "https://www.youtube.com/watch?v=EnnurXLooZw"
      },
      {
        "type": "google_maps_state",
        "mode": "place_details",
        "required_text": [
          "Keukenhof"
        ]
      }
    ],
    "expected": [
      {
        "type": "rule",
        "rules": {
          "expected": "true"
        }
      },
      {
        "type": "rule",
        "rules": {
          "expected": "true"
        }
      }
    ]
  }
}
