{
  "id": "service-interpreter_request_audio",
  "category": "service",
  "difficulty": "medium",
  "instruction": "Turn on Windows Live captions and use them to read the service-access audio on the Desktop. Save the exact form name, minimum lead time, fallback phone number, and service code to `answer.txt` on the Desktop, one item per line.",
  "source": "synthetic",
  "transcript": "For city service appointments, sign language interpreter requests use the Access Accommodation Request Form. Submit it at least five business days before the appointment. If the form is inaccessible, call 555-014-7720. Put service code ASL-5 on the request.",
  "gt_steps": [
    "Turn on Windows Live captions.",
    "Play `InterpreterRequestAudio.mp3` in Chrome with Windows Live captions running.",
    "Open Notepad.",
    "Enter `Access Accommodation Request Form\\nfive business days\\n555-014-7720\\nASL-5`, one item per line.",
    "Save the file as `answer.txt` on the Desktop.",
    "Leave Windows Live captions running."
  ],
  "config": [
    {
      "type": "upload_file",
      "parameters": {
        "files": [
          {
            "local_path": "assets/service-interpreter_request_audio.mp3",
            "path": "C:\\Users\\Docker\\Desktop\\InterpreterRequestAudio.mp3"
          }
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    },
    {
      "type": "chrome_open_tabs",
      "parameters": {
        "urls_to_open": [
          "file:///C:/Users/Docker/Desktop/InterpreterRequestAudio.mp3"
        ]
      }
    }
  ],
  "related_apps": [
    "settings",
    "chrome",
    "notepad"
  ],
  "evaluator": {
    "func": [
      "check_include_exclude",
      "check_text_points"
    ],
    "conj": "and",
    "result": [
      {
        "type": "vm_command_line",
        "command": [
          "powershell",
          "-NoProfile",
          "-Command",
          "$found = Get-Process | Where-Object { $_.ProcessName -match 'LiveCaptions|LiveCaption' -or $_.MainWindowTitle -match 'Live captions|Live Caption' }; if ($found) { 'WINDOWS_LIVE_CAPTIONS_RUNNING' } else { 'WINDOWS_LIVE_CAPTIONS_NOT_RUNNING' }"
        ]
      },
      {
        "type": "desktop_file_text",
        "filename": "answer.txt"
      }
    ],
    "expected": [
      {
        "type": "rule",
        "rules": {
          "include": [
            "WINDOWS_LIVE_CAPTIONS_RUNNING"
          ],
          "exclude": [
            "WINDOWS_LIVE_CAPTIONS_NOT_RUNNING"
          ]
        }
      },
      {
        "type": "rule",
        "rules": {
          "ignore_case": true,
          "ordered": true,
          "line_based": true,
          "points": [
            [
              "Access Accommodation Request Form"
            ],
            [
              "five business days",
              "5 business days"
            ],
            {
              "regex": [
                "\\b555\\s*-?\\s*014\\s*-?\\s*7720\\b"
              ]
            },
            [
              "ASL-5",
              "ASL 5"
            ]
          ]
        }
      }
    ]
  },
  "proxy": false,
  "fixed_ip": false,
  "possibility_of_env_change": "low"
}
