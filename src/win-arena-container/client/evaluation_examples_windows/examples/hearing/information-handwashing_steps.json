{
  "id": "information-handwashing_steps",
  "snapshot": "chrome",
  "category": "information",
  "difficulty": "hard",
  "instruction": "Turn on captions in the opened YouTube video, identify the hand-washing steps mentioned there, then record them in a Sticky Note.",
  "source": "https://www.youtube.com/watch?v=UitUdTjhZz8",
  "gt_steps": [
    "Turn on captions in the YouTube player.",
    "Play the video and use the YouTube captions to identify the hand-washing steps.",
    "Switch to Sticky Notes.",
    "Write the phrases in a sticky note: `warm water`, `soap`, `front and back`, `between your fingers`, `rinse and dry`."
  ],
  "config": [
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    },
    {
      "type": "chrome_prepare_youtube_for_live_caption",
      "parameters": {
        "url": "https://www.youtube.com/watch?v=UitUdTjhZz8",
        "wait_seconds": 1
      }
    },
    {
      "type": "execute",
      "parameters": {
        "command": [
          "powershell",
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "Start-Process 'shell:AppsFolder\\Microsoft.MicrosoftStickyNotes_8wekyb3d8bbwe!App'"
        ]
      }
    },
    {
      "type": "activate_window",
      "parameters": {
        "window_name": "Google Chrome"
      }
    }
  ],
  "trajectory": "trajectories\\",
  "related_apps": [
    "chrome",
    "sticky_notes"
  ],
  "evaluator": {
    "func": [
      "check_text_points",
      "exact_match"
    ],
    "conj": "and",
    "result": [
      {
        "type": "sticky_notes_content"
      },
      {
        "type": "youtube_captions_enabled",
        "url": "https://www.youtube.com/watch?v=UitUdTjhZz8"
      }
    ],
    "expected": [
      {
        "type": "rule",
        "rules": {
          "ignore_case": true,
          "points": [
            [
              "warm water"
            ],
            [
              "soap"
            ],
            [
              "front and back"
            ],
            [
              "between your fingers"
            ],
            [
              "rinse and dry"
            ]
          ]
        }
      },
      {
        "type": "rule",
        "rules": {
          "expected": "true"
        }
      }
    ]
  }
}
