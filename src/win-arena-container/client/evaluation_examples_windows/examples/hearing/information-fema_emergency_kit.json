  "category": "information",
  "difficulty": "hard",
  "instruction": "Enable Chrome Live Caption, watch the video, and write each must-have emergency kit item mentioned in the video in a sticky note. Each answer should contain the complete phrase exactly as it appears in the captions.",
  "source": "https://www.youtube.com/watch?v=o4enqHGluLI",
  "gt_steps": [
    "Open the FEMA emergency kit video in Chrome.",
    "Turn on Chrome Live Caption.",
    "Play the video and use Live Caption to identify the must-have emergency kit items.",
    "Open Sticky Notes.",
    "Write the items in a sticky note: `water`, `food`, `manual can opener`, `flashlight`, `extra batteries`, `weather radio`, `hand-cranked radio`, `first aid kit`, `diapers`, `infant formula`, `medicine bottles`, `children`, `pets`, `extra food`, `collapsible bowls`, `medicine`, `prescriptions`, `over-the-counter medications`."
  ],
  "config": [
    {
      "type": "launch",
