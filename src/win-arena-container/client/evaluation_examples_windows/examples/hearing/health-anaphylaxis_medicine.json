    {
      "type": "chrome_pause_video",
      "parameters": {
        "url": "https://medlineplus.gov/medlineplus-videos/histamine-the-stuff-allergies-are-made-of",
        "wait_seconds": 1
      }
    },
    {
      "type": "activate_window",
      "parameters": {
        "window_name": "Google Chrome"
      }
    }
  ],
  "related_apps": [
    "chrome",
    "notepad"
  ],
  "evaluator": {
    "func": [
