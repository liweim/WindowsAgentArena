    "Play the video with Live Caption enabled.",
    "Open Notepad.",
    "Write `epinephrine`.",
    "Save the file as `answer.txt` on the Desktop."
  ],
  "config": [
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility",
          "https://medlineplus.gov/medlineplus-videos/histamine-the-stuff-allergies-are-made-of"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
