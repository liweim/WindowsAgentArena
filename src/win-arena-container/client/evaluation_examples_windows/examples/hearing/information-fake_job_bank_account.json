{
  "id": "information-fake_job_bank_account",
  "user_group": "hearing",
  "subgroup_ids": [
    "H-S1"
  ],
  "category": "information",
  "need_ids": [
    "H1"
  ],
  "difficulty": "medium",
  "instruction": "Turn on captions in the opened YouTube video, identify the personal financial information requested in the fake job opportunity example, then save the answer in `answer.txt` on the Desktop.",
  "source": "https://www.youtube.com/watch?v=3LvMO5UMCl8",
  "gt_steps": [
    "Turn on captions in the YouTube player.",
    "Play the video and use the YouTube captions to identify the personal financial information requested in the fake job opportunity example.",
    "Open Notepad.",
    "Write `bank account number`.",
    "Save the file as `answer.txt` on the Desktop."
  ],
  "config": [
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    },
    {
      "type": "chrome_prepare_youtube_for_live_caption",
      "parameters": {
        "url": "https://www.youtube.com/watch?v=3LvMO5UMCl8",
        "wait_seconds": 1
      }
    },
    {
      "type": "activate_window",
      "parameters": {
        "window_name": "Google Chrome"
      }
    }
  ],
  "related_apps": [
    "chrome",
    "notepad"
  ],
  "evaluator": {
    "func": [
      "exact_match",
      "check_text_points"
    ],
    "conj": "and",
    "result": [
      {
        "type": "youtube_captions_enabled",
        "url": "https://www.youtube.com/watch?v=3LvMO5UMCl8"
      },
      {
        "type": "desktop_file_text",
        "filename": "answer.txt"
      }
    ],
    "expected": [
      {
        "type": "rule",
        "rules": {
          "expected": "true"
        }
      },
      {
        "type": "rule",
        "rules": {
          "ignore_case": true,
          "points": [
            [
              "bank account number",
              "banking account number",
              "bank account details",
              "banking details"
            ]
          ]
        }
      }
    ]
  },
  "proxy": true
}
