{
  "id": "health-allergy_medication",
  "category": "health",
  "need_ids": [
    "H1"
  ],
  "difficulty": "medium",
  "instruction": "Use Chrome Live Caption to identify the recommended allergy medication in the opened video, then save the medication name in `answer.txt` on the Desktop.",
  "source": "https://medlineplus.gov/ency/videos/mov/200094_eng.mp4",
  "gt_steps": [
    "Turn on Chrome Live Caption.",
    "Play the video and use Live Caption to identify the recommended medication for allergies.",
    "Open Notepad.",
    "Write `antihistamines`.",
    "Save the file as `answer.txt` on the Desktop."
  ],
  "config": [
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility",
          "https://medlineplus.gov/ency/videos/mov/200094_eng.mp4"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    },
    {
      "type": "chrome_pause_video",
      "parameters": {
        "url": "https://medlineplus.gov/ency/videos/mov/200094_eng.mp4",
        "wait_seconds": 1
      }
    },
    {
      "type": "activate_window",
      "parameters": {
        "window_name": "Google Chrome"
      }
    }
  ],
  "related_apps": [
    "chrome",
    "notepad"
  ],
  "evaluator": {
    "func": [
      "exact_match",
      "check_text_points"
    ],
    "conj": "and",
    "result": [
      {
        "type": "live_caption_enabled"
      },
      {
        "type": "desktop_file_text",
        "filename": "answer.txt"
      }
    ],
    "expected": [
      {
        "type": "rule",
        "rules": {
          "expected": "true"
        }
      },
      {
        "type": "rule",
        "rules": {
          "ignore_case": true,
          "points": [
            [
              "antihistamine",
              "antihistamines",
              "antihistamine medication"
            ]
          ]
        }
      }
    ]
  },
  "proxy": true
}
