{
  "id": "health-child_visit_preparation",
  "snapshot": "chrome",
  "category": "health",
  "difficulty": "hard",
  "instruction": "Turn on captions in the opened YouTube video, identify all recommended comfort items, clothing choices, and appointment actions, then record them in a Sticky Note.",
  "source": "https://www.youtube.com/watch?v=2BuJuk4BQIs",
  "gt_steps": [
    "Turn on captions in the YouTube player.",
    "Play the video and use the YouTube captions to identify the recommended comfort items, clothing choices, or appointment actions.",
    "Switch to Sticky Notes.",
    "Write the phrases in a sticky note: `short sleeve shirt`, `easy to remove`, `holding and talking`, `breastfeeding`, `favourite toy`, `music`, `book`, `bandage`, `reward`, `vaccination record`, `15 minutes`."
  ],
  "config": [
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    },
    {
      "type": "chrome_prepare_youtube_for_live_caption",
      "parameters": {
        "url": "https://www.youtube.com/watch?v=2BuJuk4BQIs",
        "wait_seconds": 1
      }
    },
    {
      "type": "execute",
      "parameters": {
        "command": [
          "powershell",
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "Start-Process 'shell:AppsFolder\\Microsoft.MicrosoftStickyNotes_8wekyb3d8bbwe!App'"
        ]
      }
    },
    {
      "type": "activate_window",
      "parameters": {
        "window_name": "Google Chrome"
      }
    }
  ],
  "trajectory": "trajectories\\",
  "related_apps": [
    "chrome",
    "sticky_notes"
  ],
  "evaluator": {
    "func": [
      "check_text_points",
      "exact_match"
    ],
    "conj": "and",
    "result": [
      {
        "type": "sticky_notes_content"
      },
      {
        "type": "youtube_captions_enabled",
        "url": "https://www.youtube.com/watch?v=2BuJuk4BQIs"
      }
    ],
    "expected": [
      {
        "type": "rule",
        "rules": {
          "ignore_case": true,
          "points": [
            [
              "short sleeve shirt"
            ],
            [
              "easy to remove"
            ],
            [
              "holding and talking"
            ],
            [
              "breastfeeding"
            ],
            [
              "favourite toy"
            ],
            [
              "music"
            ],
            [
              "book"
            ],
            [
              "bandage"
            ],
            [
              "reward"
            ],
            [
              "vaccination record"
            ],
            [
              "15 minutes"
            ]
          ]
        }
      },
      {
        "type": "rule",
        "rules": {
          "expected": "true"
        }
      }
    ]
  }
}
