{
  "id": "access-chrome_live_caption_language",
  "manually_evaluated": true,
  "user_group": "hearing",
  "subgroup_ids": [
    "H-S1"
  ],
  "category": "access",
  "need_ids": [
    "H2"
  ],
  "difficulty": "easy",
  "instruction": "Enable Live Caption in Chrome and add Spanish as a supported caption language.",
  "source": "synthetic",
  "gt_steps": [
    "Open chrome://settings/accessibility.",
    "Turn on Live Caption.",
    "Open Manage languages under Supported caption languages.",
    "Add Spanish."
  ],
  "config": [
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    }
  ],
  "related_apps": [
    "chrome"
  ],
  "evaluator": {
    "func": [
      "exact_match",
      "is_in_list"
    ],
    "conj": "and",
    "result": [
      {
        "type": "live_caption_enabled"
      },
      {
        "type": "live_caption_languages"
      }
    ],
    "expected": [
      {
        "type": "rule",
        "rules": {
          "expected": "true"
        }
      },
      {
        "type": "rule",
        "rules": {
          "expected": "es"
        }
      }
    ]
  },
  "proxy": false
}
