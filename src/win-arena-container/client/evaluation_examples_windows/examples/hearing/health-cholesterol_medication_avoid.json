{
  "id": "health-cholesterol_medication_avoid",
  "snapshot": "chrome",
  "category": "health",
  "difficulty": "medium",
  "instruction": "I am taking cholesterol-lowering medicine and need to know what I should not eat or drink. Turn on captions in the opened YouTube video, then watch it and save the answer in `answer.txt` on the Desktop.",
  "source": "https://www.youtube.com/watch?v=Jy6ShnLDBWg",
  "gt_steps": [
    "Turn on captions in the YouTube player.",
    "Play the video and use the YouTube captions to identify what should not be eaten or drunk while taking cholesterol-lowering medicine.",
    "Create answer.txt on the Desktop.",
    "Write `grapefruit` in answer.txt.",
    "Save and close answer.txt."
  ],
  "config": [
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    },
    {
      "type": "chrome_prepare_youtube_for_live_caption",
      "parameters": {
        "url": "https://www.youtube.com/watch?v=Jy6ShnLDBWg",
        "wait_seconds": 1
      }
    },
    {
      "type": "activate_window",
      "parameters": {
        "window_name": "Google Chrome"
      }
    }
  ],
  "trajectory": "trajectories\\",
  "related_apps": [
    "chrome"
  ],
  "evaluator": {
    "func": [
      "exact_match",
      "exact_match"
    ],
    "conj": "and",
    "result": [
      {
        "type": "youtube_captions_enabled",
        "url": "https://www.youtube.com/watch?v=Jy6ShnLDBWg"
      },
      {
        "type": "is_file_saved_desktop",
        "filename": "answer.txt",
        "textcontent": "grapefruit"
      }
    ],
    "expected": [
      {
        "type": "rule",
        "rules": {
          "expected": "true"
        }
      },
      {
        "type": "rule",
        "rules": {
          "expected": "true"
        }
      }
    ]
  }
}
