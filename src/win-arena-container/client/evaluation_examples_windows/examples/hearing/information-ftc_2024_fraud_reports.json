  "difficulty": "hard",
  "operation_time": 175.73,
  "instruction": "Use Chrome Live Caption on the opened video to identify the FTC Explore Data address, then find the nationwide total number of fraud reports for all quarters of 2024 and save only that number in `answer.txt` on the Desktop.",
  "source": "https://www.ftc.gov/media/video-0194-explore-data-ftc",
  "gt_steps": [
    "Turn on Chrome Live Caption.",
    "Play the video with Live Caption enabled.",
    "Open ftc.gov/exploredata.",
    "Go to State and Metro Area Maps.",
    "Open Fraud & ID Theft by State.",
    "Set the year to 2024 and Quarter to `All`.",
    "Keep the map on the nationwide view.",
    "Open Notepad.",
    "Write `2642652`.",
    "Save the file as `answer.txt` on the Desktop."
  ],
  "config": [
    {
      "type": "upload_file",
      "parameters": {
        "files": [
          {
            "local_path": "../assets/information-ftc_2024_fraud_reports.mp4",
            "path": "C:\\Users\\Docker\\Desktop\\FTC2024FraudReports.mp4"
          }
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    },
    {
      "type": "sleep",
      "parameters": {
        "seconds": 1
      }
    },
    {
      "type": "chrome_open_tabs",
      "parameters": {
        "urls_to_open": [
          "file:///C:/Users/Docker/Desktop/FTC2024FraudReports.mp4"
        ]
      }
    },
    {
      "type": "chrome_pause_video",
      "parameters": {
        "url": "file:///C:/Users/Docker/Desktop/FTC2024FraudReports.mp4",
        "wait_seconds": 1
      }
    },
    {
      "type": "activate_window",
      "parameters": {
        "window_name": "Google Chrome"
      }
    }
  ],
  "related_apps": [
    "chrome",
    "notepad"
  ],
  "evaluator": {
    "func": [
      "exact_match",
      "check_include_exclude"
    ],
    "conj": "and",
    "result": [
      {
        "type": "live_caption_enabled"
      },
      {
        "type": "vm_command_line",
        "command": [
          "powershell",
          "-NoProfile",
          "-Command",
          "$path = Join-Path $env:USERPROFILE 'Desktop\\answer.txt'; if (Test-Path $path) { ((Get-Content $path -Raw) -replace '[,\\s]', '') }"
        ]
      }
    ],
    "expected": [
