{
  "id": "service-ftc_complaint_1",
  "snapshot": "chrome",
  "category": "service",
  "difficulty": "easy",
  "instruction": "Turn on captions in the opened YouTube video, then watch it and open the complaint website it mentions in Chrome.",
  "source": "https://www.youtube.com/watch?v=3LvMO5UMCl8",
  "gt_steps": [
    "Turn on captions in the YouTube player.",
    "Play the video and use the YouTube captions to identify where victims should go to file a complaint online.",
    "Open https://reportfraud.ftc.gov in Chrome."
  ],
  "config": [
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    },
    {
      "type": "chrome_prepare_youtube_for_live_caption",
      "parameters": {
        "url": "https://www.youtube.com/watch?v=3LvMO5UMCl8",
        "wait_seconds": 1
      }
    },
    {
      "type": "activate_window",
      "parameters": {
        "window_name": "Google Chrome"
      }
    }
  ],
  "trajectory": "trajectories\\",
  "related_apps": [
    "chrome"
  ],
  "evaluator": {
    "func": [
      "exact_match",
      "is_expected_active_tab"
    ],
    "conj": "and",
    "result": [
      {
        "type": "youtube_captions_enabled",
        "url": "https://www.youtube.com/watch?v=3LvMO5UMCl8"
      },
      {
        "type": "active_tab_info",
        "goto_prefix": "https://"
      }
    ],
    "expected": [
      {
        "type": "rule",
        "rules": {
          "expected": "true"
        }
      },
      {
        "type": "rule",
        "rules": {
          "type": "url",
          "url": "https://reportfraud.ftc.gov"
        }
      }
    ]
  }
}
