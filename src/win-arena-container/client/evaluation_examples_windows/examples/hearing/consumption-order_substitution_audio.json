{
  "id": "consumption-order_substitution_audio",
  "category": "consumption",
  "need_ids": [
    "H1"
  ],
  "difficulty": "medium",
  "instruction": "Use Chrome Live Caption to read the grocery order recording on the Desktop. Create a Sticky Note containing the unavailable item, approved substitute, price limit, and pickup code.",
  "source": "synthetic",
  "transcript": "Grocery order update. The oat yoghurt is unavailable. Substitute plain soy yoghurt only. Do not accept a substitute over $6.50. Pickup code GP-284.",
  "gt_steps": [
    "Turn on Chrome Live Caption.",
    "Play `OrderSubstitutionAudio.mp3` in Chrome with Live Caption enabled.",
    "Create a new note in Sticky Notes.",
    "Enter `Unavailable: oat yoghurt\\nSubstitute: plain soy yoghurt only\\nPrice limit: $6.50\\nPickup code: GP-284` into the note.",
    "Keep the completed note saved.",
    "Leave Chrome Live Caption enabled."
  ],
  "config": [
    {
      "type": "upload_file",
      "parameters": {
        "files": [
          {
            "local_path": "assets/consumption-order_substitution_audio.mp3",
            "path": "C:\\Users\\Docker\\Desktop\\OrderSubstitutionAudio.mp3"
          }
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    },
    {
      "type": "sleep",
      "parameters": {
