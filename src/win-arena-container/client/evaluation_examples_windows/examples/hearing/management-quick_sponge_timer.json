    {
      "type": "chrome_prepare_youtube_for_live_caption",
      "parameters": {
        "url": "https://foodwishes.blogspot.com/2013/04/pita-bread-whats-in-your-pocket.html",
        "wait_seconds": 1
      }
    },
    {
      "type": "activate_window",
      "parameters": {
        "window_name": "Google Chrome"
      }
    }
  ],
  "related_apps": [
    "chrome"
  ],
  "evaluator": {
