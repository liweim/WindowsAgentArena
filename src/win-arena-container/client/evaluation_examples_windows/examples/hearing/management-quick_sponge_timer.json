{
  "id": "management-quick_sponge_timer",
  "snapshot": "chrome",
  "category": "management",
  "difficulty": "medium",
  "instruction": "Enable Windows Live Captions, watch the video, determine how long the quick sponge should sit before checking whether the yeast is active, then use https://vclock.com to create a timer for that duration. Leave the timer visible in the browser.",
  "source": "https://www.youtube.com/watch?v=NPiA69p4gqE",
  "gt_steps": [
    "Turn on Windows Live captions.",
    "Watch the YouTube video and use the live captions to determine that the quick sponge should sit for 15 minutes before checking whether the yeast is active.",
    "Open https://vclock.com in the browser.",
    "Click the Timer page.",
    "Create and start a 15 minute timer.",
    "Leave the timer visible in the browser."
  ],
  "config": [
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    },
    {
      "type": "chrome_prepare_youtube_for_live_caption",
      "parameters": {
        "url": "https://www.youtube.com/watch?v=NPiA69p4gqE",
        "wait_seconds": 1
      }
    },
    {
      "type": "activate_window",
      "parameters": {
        "window_name": "Google Chrome"
      }
    }
  ],
  "trajectory": "trajectories\\",
  "related_apps": [
    "chrome"
  ],
  "evaluator": {
    "func": "is_expected_url_pattern_match",
    "result": {
      "type": "active_tab_info_simple"
    },
    "expected": {
      "type": "rule",
      "rules": {
        "expected": [
          "https?://(www\\.)?vclock\\.com/timer/#countdown=00:15:00(&|$)"
        ]
      }
    }
  }
}
