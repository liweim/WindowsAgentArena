{
  "id": "mobility-narrator_find_nearest_pharmacy_unsw_library",
  "_comment": "Allow personal data like UNSW",
  "manually_evaluated": false,
  "snapshot": "chrome",
  "category": "mobility",
  "difficulty": "medium",
  "instruction": "Turn on Windows Narrator. Use it to navigate Google Maps and find the nearest pharmacy to the UNSW Main Library. Open the place details for the nearest pharmacy and leave the place details open.",
  "source": "Google Maps",
  "gt_steps": [
    "Turn on Windows Narrator.",
    "Open Google Maps in Chrome.",
    "Search near UNSW Main Library for pharmacies.",
    "Identify Pharmacy at UNSW as the nearest pharmacy.",
    "Open the Pharmacy at UNSW place details.",
    "Leave the place details open."
  ],
  "config": [
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    },
    {
      "type": "sleep",
      "parameters": {
        "seconds": 1
      }
    },
    {
      "type": "chrome_open_tabs",
      "parameters": {
        "urls_to_open": [
          "https://www.google.com/maps"
        ]
      }
    }
  ],
  "trajectory": "trajectories\\",
  "related_apps": [
    "narrator",
    "chrome"
  ],
  "evaluator": {
    "func": [
      "check_narrator_enabled",
      "exact_match"
    ],
    "conj": "and",
    "result": [
      {
        "type": "narrator_status"
      },
      {
        "type": "google_maps_state",
        "mode": "place_details",
        "required_text": [
          [
            "Pharmacy at UNSW"
          ]
        ]
      }
    ],
    "expected": [
      {
        "type": "rule",
        "rules": {}
      },
      {
        "type": "rule",
        "rules": {
          "expected": "true"
        }
      }
    ]
  },
  "proxy": false,
  "fixed_ip": false,
  "possibility_of_env_change": "low"
}
