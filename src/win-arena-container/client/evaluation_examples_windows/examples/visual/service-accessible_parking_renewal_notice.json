{
  "id": "service-accessible_parking_renewal_notice",
  "category": "service",
  "difficulty": "medium",
  "instruction": "Enable Windows Magnifier and keep it open. Read the small-print accessible-parking renewal notice image on the Desktop and save the permit reference, renewal deadline, and help-line phone number to `answer.txt` on the Desktop, one item per line in that order.",
  "source": "synthetic",
  "gt_steps": [
    "Enable Windows Magnifier and leave it open.",
    "Open `ParkingRenewalNotice.png` on the Desktop.",
    "Open Notepad.",
    "Enter `AP-60428\\n30 September 2026\\n555-018-4402`, one item per line.",
    "Save the file as `answer.txt` on the Desktop.",
    "Leave Windows Magnifier open."
  ],
  "config": [
    {
      "type": "upload_file",
      "parameters": {
        "files": [
          {
            "local_path": "assets/service-accessible_parking_renewal_notice.png",
            "path": "C:\\Users\\Docker\\Desktop\\ParkingRenewalNotice.png"
          }
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "file:///C:/Users/Docker/Desktop/ParkingRenewalNotice.png"
        ]
      }
    }
  ],
  "related_apps": [
    "magnifier",
    "chrome",
    "notepad"
  ],
  "evaluator": {
    "func": [
      "check_include_exclude",
      "exact_match"
    ],
    "conj": "and",
    "result": [
      {
        "type": "vm_command_line",
        "command": "powershell -Command \"if (Get-Process Magnify -ErrorAction SilentlyContinue) { Write-Output 'MAGNIFIER_OPEN' } else { Write-Output 'MAGNIFIER_CLOSED' }\"",
        "shell": true
      },
      {
        "type": "is_file_saved_desktop",
        "filename": "answer.txt",
        "textcontent": "AP-60428\n30 September 2026\n555-018-4402",
        "exact": true
      }
    ],
    "expected": [
      {
        "type": "rule",
        "rules": {
          "include": [
            "MAGNIFIER_OPEN"
          ],
          "exclude": [
            "MAGNIFIER_CLOSED"
          ]
        }
      },
      {
        "type": "rule",
        "rules": {
          "expected": "true"
        }
      }
    ]
  },
  "proxy": false,
  "fixed_ip": false,
  "possibility_of_env_change": "low"
}
