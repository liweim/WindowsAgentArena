{
  "id": "health-hospital_wayfinding_map",
  "user_group": "visual",
  "subgroup_ids": ["V-S1", "V-S2"],
  "category": "health",
  "need_ids": [
    "V5"
  ],
  "difficulty": "hard",
  "instruction": "Use the original Queen Elizabeth Hospital site map PDF on the Desktop and save `answer.txt` with the zone and level for Outpatient Pharmacy, MRI Scanner, Outpatients Department (OPD), and Radiology (X-ray and CT scanning), one service-location pair per line in that order.",
  "source": "https://www.gatesheadhealth.nhs.uk/wp-content/uploads/2026/04/QEH00-Z-Website-Site-Map.pdf",
  "gt_steps": [
    "Open Notepad.",
    "Enter the following text:\n`Outpatient Pharmacy: Blue Zone - Level 2\nMRI Scanner: Purple Zone - Level 2\nOutpatients Department (OPD): Orange Zone - Level 3\nRadiology (X-ray and CT scanning): Orange Zone - Level 3`",
    "Save the file as `answer.txt` on the Desktop."
  ],
  "config": [
    {
      "type": "upload_file",
      "parameters": {
        "files": [
          {
            "local_path": "assets/health-hospital_wayfinding_map.pdf",
            "path": "C:\\Users\\Docker\\Desktop\\HospitalMap.pdf"
          }
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "msedge",
          "file:///C:/Users/Docker/Desktop/HospitalMap.pdf"
        ]
      }
    }
  ],
  "related_apps": [
    "msedge",
    "notepad"
  ],
  "evaluator": {
    "func": "check_text_points",
    "result": {
      "type": "desktop_file_text",
      "filename": "answer.txt"
    },
    "expected": {
      "type": "rule",
      "rules": {
        "ignore_case": true,
        "ordered": true,
        "line_based": true,
        "points": [
          {
            "all_of": [
              [
                "Outpatient Pharmacy"
              ],
              [
                "Blue Zone"
              ],
              [
                "Level 2"
              ]
            ]
          },
          {
            "all_of": [
              [
                "MRI Scanner",
                "MRI"
              ],
              [
                "Purple Zone"
              ],
              [
                "Level 2"
              ]
            ]
          },
          {
            "all_of": [
              [
                "Outpatients Department",
                "OPD"
              ],
              [
                "Orange Zone"
              ],
              [
                "Level 3"
              ]
            ]
          },
          {
            "all_of": [
              [
                "Radiology",
                "X-ray",
                "CT scanning"
              ],
              [
                "Orange Zone"
              ],
              [
                "Level 3"
              ]
            ]
          }
        ]
      }
    }
  },
  "proxy": false,
  "possibility_of_env_change": "low"
}
