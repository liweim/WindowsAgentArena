{
  "id": "access-chrome_zoom_150",
  "_comment": "The URL should be opened during initialization. The instruction can simply say, “Increase the page zoom level to 150%.” The evaluator can skip checking the URL, since opening it isn’t the main point of this task.",
  "user_group": "visual",
  "subgroup_ids": ["V-S2"],
  "category": "access",
  "need_ids": [
    "V2"
  ],
  "difficulty": "easy",
  "instruction": "Set the Chrome page zoom to 150% on https://www.digital.nsw.gov.au/delivery/accessibility-and-inclusivity-toolkit and leave the page open.",
  "source": "https://www.digital.nsw.gov.au/delivery/accessibility-and-inclusivity-toolkit",
  "gt_steps": [
    "Open Google Chrome.",
    "Navigate to https://www.digital.nsw.gov.au/delivery/accessibility-and-inclusivity-toolkit.",
    "Wait for the webpage to load.",
    "Open the Chrome zoom controls.",
    "Increase the page zoom level to 150%.",
    "Leave the webpage open with the zoom indicator showing 150%."
  ],
  "config": [
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337"
        ]
      }
    }
  ],
  "related_apps": [
    "chrome"
  ],
  "evaluator": {
    "func": [
      "check_zoom_access_tree",
      "is_expected_url_pattern_match"
    ],
    "conj": "and",
    "result": [
      {
        "type": "chrome_page_zoom_from_preferences"
      },
      {
        "type": "active_tab_info_simple"
      }
    ],
    "expected": [
      {
        "type": "rule",
        "rules": {
          "zoom": "150%"
        }
      },
      {
        "type": "rule",
        "rules": {
          "expected": [
            "https?://(www\\.)?digital\\.nsw\\.gov\\.au/delivery/accessibility-and-inclusivity-toolkit/?([?#].*)?$"
          ]
        }
      }
    ]
  },
  "proxy": true,
  "possibility_of_env_change": "low"
}
