{
  "id": "consumption-bathroom_accessory_price_sort",
  "user_group": "visual",
  "subgroup_ids": [
    "V-S1"
  ],
  "category": "consumption",
  "need_ids": [
    "V1"
  ],
  "difficulty": "medium",
  "operation_time": 70.0,
  "instruction": "I rely on a screen reader to shop online. Turn on Windows Narrator, then use OneStopShop to open the `Bathroom Accessories` category, sort the products from lowest to highest price, and add exactly two units of the cheapest item to the shopping cart. Leave the cart page open.",
  "source": "synthetic",
  "gt_steps": [
    "Turn on Windows Narrator.",
    "Open the OneStopShop website already available in Chrome.",
    "Use Narrator to navigate to `Home & Kitchen`, then `Bath`, then `Bathroom Accessories`.",
    "Sort the category by price from low to high.",
    "Open the first and cheapest product, SKU `B07QRRDZJ5`.",
    "Set the quantity to 2 and add the product to the shopping cart.",
    "Open the shopping cart and leave it visible."
  ],
  "config": [
    {
      "type": "reset_shopping_cart",
      "parameters": {}
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    },
    {
      "type": "sleep",
      "parameters": {
        "seconds": 1
      }
    },
    {
      "type": "chrome_open_tabs",
      "parameters": {
        "urls_to_open": [
          "http://host.docker.internal:7770"
        ]
      }
    }
  ],
  "related_apps": [
    "chrome"
  ],
  "evaluator": {
    "func": [
      "check_narrator_enabled",
      "is_page_contains_items",
      "is_expected_active_tab"
    ],
    "conj": "and",
    "result": [
      {
        "type": "narrator_status"
      },
      {
        "type": "page_info",
        "url": "http://host.docker.internal:7770/checkout/cart/",
        "load_state": "networkidle"
      },
      {
        "type": "active_tab_info",
        "goto_prefix": "http://"
      }
    ],
    "expected": [
      {
        "type": "rule",
        "rules": {}
      },
      {
        "type": "rule",
        "rules": {
          "items": [
            {
              "sku": "B07QRRDZJ5",
              "quantity": 2
            }
          ]
        }
      },
      {
        "type": "rule",
        "rules": {
          "type": "url",
          "url": "http://host.docker.internal:7770/checkout/cart/"
        }
      }
    ],
    "metric_roles": {
      "task_outcome": [
