{
  "id": "mobility-nearest_pharmacy_unsw_library",
  "_comment": "Allow personal data like UNSW",
  "manually_evaluated": false,
  "category": "mobility",
  "need_ids": [
    "V1"
  ],
  "difficulty": "medium",
  "instruction": "Turn on Windows Narrator. Use Google Maps with UNSW Main Library as the fixed start point and search for pharmacies. Choose the pharmacy with the shortest displayed walking distance from the library; if distances tie, choose the shorter walking time. Open that pharmacy's place details and leave them open.",
  "source": "synthetic",
  "gt_steps": [
    "Turn on Windows Narrator.",
    "Open Google Maps in Chrome.",
    "Search near UNSW Main Library for pharmacies.",
    "Identify Pharmacy at UNSW as the nearest pharmacy.",
    "Open the Pharmacy at UNSW place details.",
    "Leave the place details open."
  ],
  "config": [
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    },
    {
      "type": "sleep",
      "parameters": {
        "seconds": 1
      }
    },
    {
      "type": "chrome_open_tabs",
      "parameters": {
        "urls_to_open": [
          "https://www.google.com/maps"
        ]
      }
    }
  ],
  "related_apps": [
    "narrator",
    "chrome"
  ],
  "evaluator": {
    "func": [
      "check_narrator_enabled",
      "exact_match"
    ],
    "conj": "and",
    "result": [
      {
        "type": "narrator_status"
      },
      {
        "type": "google_maps_state",
        "mode": "place_details",
        "required_text": [
          [
            "Pharmacy at UNSW"
          ]
        ]
      }
    ],
    "expected": [
      {
        "type": "rule",
        "rules": {}
      },
      {
        "type": "rule",
        "rules": {
          "expected": "true"
        }
      }
    ]
  },
  "proxy": true,
  "possibility_of_env_change": "low"
}
