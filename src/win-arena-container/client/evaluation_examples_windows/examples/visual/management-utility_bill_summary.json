{
  "id": "management-utility_bill_summary",
  "_comment": "",
  "manually_evaluated": false,
  "user_group": "visual",
  "subgroup_ids": ["V-S1"],
  "category": "management",
  "need_ids": [
    "V1"
  ],
  "difficulty": "hard",
  "instruction": "Enable Windows Narrator and keep it enabled. Populate the provided `BillSummary.ods` with the provider, due date, and total amount due from each of the three provided utility bills, then save the spreadsheet as `answer.ods` on the Desktop.",
  "source": "synthetic",
  "gt_steps": [
    "Enable Windows Narrator.",
    "Open BluePeak_Electricity_Bill.pdf.",
    "Identify the provider as BluePeak Utilities.",
    "Identify the due date as 18 August 2026.",
    "Identify the total amount due as $184.65.",
    "Open ClearFlow_Water_Bill.pdf.",
    "Identify the provider as ClearFlow Water Services.",
    "Identify the due date as 2 September 2026.",
    "Identify the total amount due as $96.40.",
    "Open GreenFlame_Gas_Bill.pdf.",
    "Identify the provider as GreenFlame Energy.",
    "Identify the due date as 7 September 2026.",
    "Identify the total amount due as $128.75.",
    "Open BillSummary.ods.",
    "Enter all three bills into the spreadsheet.",
    "Save the spreadsheet as `answer.ods` on the Desktop.",
    "Keep Narrator enabled."
  ],
  "config": [
    {
      "type": "upload_file",
      "parameters": {
        "files": [
          {
            "local_path": "assets/management-utility_bill_summary_electricity.pdf",
            "path": "C:\\Users\\Docker\\Desktop\\BluePeak_Electricity_Bill.pdf"
          },
          {
            "local_path": "assets/management-utility_bill_summary_water.pdf",
            "path": "C:\\Users\\Docker\\Desktop\\ClearFlow_Water_Bill.pdf"
          },
          {
            "local_path": "assets/management-utility_bill_summary_gas.pdf",
            "path": "C:\\Users\\Docker\\Desktop\\GreenFlame_Gas_Bill.pdf"
          },
          {
            "local_path": "assets/management-utility_bill_summary.ods",
            "path": "C:\\Users\\Docker\\Desktop\\BillSummary.ods"
          }
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "libreoffice",
          "C:\\Users\\Docker\\Desktop\\BillSummary.ods"
        ]
      }
    },
    {
      "type": "sleep",
      "parameters": {
        "seconds": 3
      }
    }
  ],
  "related_apps": [
    "narrator",
    "msedge",
    "libreoffice_calc"
  ],
  "evaluator": {
    "func": [
      "check_include_exclude",
      "check_ods_cell_values"
    ],
    "conj": "and",
    "result": [
      {
        "type": "vm_command_line",
        "command": "powershell -Command \"if (Get-Process Narrator -ErrorAction SilentlyContinue){'NARRATOR_OPEN'}else{'NARRATOR_CLOSED'}\"",
        "shell": true
      },
      {
        "type": "vm_file",
        "path": "C:\\Users\\Docker\\Desktop\\answer.ods",
        "dest": "answer.ods"
      }
    ],
    "expected": [
      {
        "type": "rule",
        "rules": {
          "include": [
            "NARRATOR_OPEN"
          ],
          "exclude": [
            "NARRATOR_CLOSED"
          ]
        }
      },
      {
        "type": "rule",
        "rules": {
          "sheet": "Bill Summary",
          "cells": {
            "B4": "BluePeak Utilities",
            "C4": "18 August 2026",
            "D4": "$184.65",
            "B5": "ClearFlow Water Services",
            "C5": "2 September 2026",
            "D5": "$96.40",
            "B6": "GreenFlame Energy",
            "C6": "7 September 2026",
            "D6": "$128.75"
          }
        }
      }
    ]
  },
  "proxy": false,
  "possibility_of_env_change": "low"
}
