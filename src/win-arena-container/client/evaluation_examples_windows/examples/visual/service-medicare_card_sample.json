{
  "id": "service-medicare_card_sample",
  "category": "service",
  "difficulty": "medium",
  "instruction": "Use the original sample Medicare card image on the Desktop and save `answer.txt` with the sample name, Medicare Number, Part A coverage type and start date, and Part B coverage type and start date, one item per line in that order.",
  "source": "https://www.medicare.gov/sites/default/files/Medicare_card_new.jpg",
  "gt_steps": [
    "Open Notepad.",
    "Enter the following text:\n`Name: JOHN L SMITH\nMedicare Number: 1EG4-TE5-MK72\nPart A: HOSPITAL - 03-01-2016\nPart B: MEDICAL - 03-01-2016`",
    "Save the file as `answer.txt` on the Desktop."
  ],
  "config": [
    {
      "type": "upload_file",
      "parameters": {
        "files": [
          {
            "local_path": "assets/service-medicare_card_sample.jpg",
            "path": "C:\\Users\\Docker\\Desktop\\MedicareCard.jpg"
          }
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "C:\\Windows\\System32\\mspaint.exe",
          "C:\\Users\\Docker\\Desktop\\MedicareCard.jpg"
        ]
      }
    }
  ],
  "related_apps": [
    "paint",
    "notepad"
  ],
  "evaluator": {
    "func": "check_text_points",
    "result": {
      "type": "desktop_file_text",
      "filename": "answer.txt"
    },
    "expected": {
      "type": "rule",
      "rules": {
        "ignore_case": true,
        "ordered": true,
        "line_based": true,
        "points": [
          {
            "all_of": [
              [
                "JOHN L SMITH",
                "John L. Smith",
                "John L Smith"
              ]
            ]
          },
          {
            "all_of": [
              [
                "1EG4-TE5-MK72",
                "1EG4 TE5 MK72"
              ]
            ]
          },
          {
            "all_of": [
              [
                "Part A"
              ],
              [
                "HOSPITAL",
                "hospital coverage"
              ],
              [
                "03-01-2016",
                "03/01/2016",
                "March 1, 2016",
                "1 March 2016"
              ]
            ]
          },
          {
            "all_of": [
              [
                "Part B"
              ],
              [
                "MEDICAL",
                "medical coverage"
              ],
              [
                "03-01-2016",
                "03/01/2016",
                "March 1, 2016",
                "1 March 2016"
              ]
            ]
          }
        ]
      }
    }
  },
  "proxy": false,
  "fixed_ip": false,
  "possibility_of_env_change": "low"
}
