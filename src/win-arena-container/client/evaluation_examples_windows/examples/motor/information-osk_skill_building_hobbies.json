{
  "id": "information-osk_skill_building_hobbies",
  "_comment": "",
  "manually_evaluated": true,
  "snapshot": "chrome",
  "category": "information",
  "difficulty": "medium",
  "instruction": "Enable the Windows On-Screen Keyboard as a motor accessibility aid and keep it enabled throughout the task. On the Covey webpage already open in Chrome, find the 11 examples listed under \"11 Examples of Skill-Building Hobbies for Adults with Disabilities\". Open Notepad and write only the 11 hobby topics exactly as written on the webpage, one topic per line. Do not include numbers, bullet symbols, or descriptions, and do not paraphrase. Write every topic in lowercase. Save the file as `hobbies.txt` on the Desktop.",
  "source": "https://covey.org/11-skill-building-hobbies-for-adults-with-disabilities/",
  "gt_steps": [
    "Open Windows Accessibility keyboard settings.",
    "Enable the On-Screen Keyboard and keep it enabled.",
    "Return to the Covey webpage already open in Chrome.",
    "Find the section titled `11 Examples of Skill-Building Hobbies for Adults with Disabilities`.",
    "Identify the 11 hobby topics.",
    "Open Notepad.",
    "Write `biking` on its own line.",
    "Write `book club` on its own line.",
    "Write `art` on its own line.",
    "Write `swimming` on its own line.",
    "Write `gardening` on its own line.",
    "Write `cooking or baking` on its own line.",
    "Write `adaptive sports` on its own line.",
    "Write `dancing` on its own line.",
    "Write `photography` on its own line.",
    "Write `music` on its own line.",
    "Write `volunteering` on its own line.",
    "Save the file as `hobbies.txt` on the Desktop.",
    "Leave the saved file on the Desktop.",
    "Leave the On-Screen Keyboard enabled."
  ],
  "config": [
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility",
          "https://covey.org/11-skill-building-hobbies-for-adults-with-disabilities/"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    },
    {
      "type": "activate_window",
      "parameters": {
        "window_name": "Google Chrome"
      }
    }
  ],
  "trajectory": "trajectories\\",
  "related_apps": [
    "settings",
