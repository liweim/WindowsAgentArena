    "on_screen_keyboard"
  ],
  "evaluator": {
    "func": [
      "check_include_exclude",
      "check_include_exclude"
    ],
    "conj": "and",
    "result": [
      {
        "type": "vm_command_line",
        "command": "powershell -NoProfile -Command \"if (Get-Process osk -ErrorAction SilentlyContinue) { Write-Output 'OSK_OPEN' } else { Write-Output 'OSK_CLOSED' }\"",
        "shell": true
      },
      {
        "type": "vm_command_line",
        "command": "powershell -NoProfile -Command \"$path=Join-Path ([Environment]::GetFolderPath('Desktop')) 'hobbies.txt'; if (Test-Path $path) { Get-Content -Raw $path } else { Write-Output 'FILE_NOT_FOUND' }\"",
        "shell": true
      }
    ],
    "expected": [
      {
        "type": "rule",
        "rules": {
          "include": [
            "OSK_OPEN"
          ],
          "exclude": [
            "OSK_CLOSED"
          ]
        }
      },
      {
        "type": "rule",
        "rules": {
          "include": [
            "biking",
            "book club",
            "art",
            "swimming",
            "gardening",
            "cooking or baking",
            "adaptive sports",
            "dancing",
            "photography",
            "music",
            "volunteering"
          ],
          "exclude": [
            "FILE_NOT_FOUND"
          ]
        }
      }
    ]
