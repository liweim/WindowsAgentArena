{
  "id": "access-enable_mouse_keys",
  "manually_evaluated": true,
  "user_group": "motor",
  "subgroup_ids": ["M-S2"],
  "category": "access",
  "need_ids": [
    "M4"
  ],
  "difficulty": "easy",
  "instruction": "Enable Mouse Keys and keep it enabled.",
  "source": "synthetic",
  "gt_steps": [
    "Open Windows settings.",
    "Navigate to Mouse accessibility settings.",
    "Turn on the Mouse Keys.",
    "Keep the Mouse Keys enabled."
  ],
  "config": [],
  "related_apps": [
    "settings"
  ],
  "evaluator": {
    "func": "check_include_exclude",
    "result": {
      "type": "vm_command_line",
      "command": "powershell -NoProfile -Command \"$flags = [int](Get-ItemPropertyValue -Path 'HKCU:\\Control Panel\\Accessibility\\MouseKeys' -Name 'Flags'); if (($flags -band 1) -eq 1) { Write-Output 'MOUSE_KEYS_ENABLED' } else { Write-Output 'MOUSE_KEYS_DISABLED' }\"",
      "shell": true
    },
    "expected": {
      "type": "rule",
      "rules": {
        "include": [
          "MOUSE_KEYS_ENABLED"
        ],
        "exclude": [
          "MOUSE_KEYS_DISABLED"
        ]
      }
    }
  },
  "proxy": false,
  "possibility_of_env_change": "low"
}
