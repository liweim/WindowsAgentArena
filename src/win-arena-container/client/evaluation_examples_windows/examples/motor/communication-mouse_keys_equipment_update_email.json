{
  "id": "communication-mouse_keys_equipment_update_email",
  "category": "communication",
  "difficulty": "medium",
  "instruction": "Enable Windows Mouse Keys and keep them enabled. Use the official Quantum 600E owner’s manual saved on the Desktop to draft a Thunderbird email to `equipmentdesk@example.org` with subject `Quantum 600E charging guidance`. Include the battery type and voltage, the required charger, and the extension-cord warning. Do not send it.",
  "source": "https://www.quantumrehab.com/pdf/owners-manuals/us_q600e_om.pdf",
  "gt_steps": [
    "Enable Windows Mouse Keys and leave them enabled.",
    "Switch to the Quantum 600E owner’s manual open in Chrome.",
    "Use the PDF find control to locate `BATTERIES AND CHARGING`.",
    "Create a new email draft in Thunderbird.",
    "Set To to `equipmentdesk@example.org`.",
    "Set Subject to `Quantum 600E charging guidance`.",
    "Enter the following message body:\n`The Quantum 600E uses two 12-volt deep-cycle batteries that are sealed and maintenance free. Recharge the batteries with the supplied off-board battery charger. Never use an extension cord to plug in the battery charger.`",
    "Save the message as a draft. Do not send it.",
    "Leave Windows Mouse Keys enabled."
  ],
  "config": [
    {
      "type": "upload_file",
      "parameters": {
        "files": [
          {
            "local_path": "assets/communication-mouse_keys_equipment_update_email.pdf",
            "path": "C:\\Users\\Docker\\Desktop\\Quantum600EManual.pdf"
          }
        ]
      }
    },
    {
      "type": "download",
      "parameters": {
        "files": [
          {
            "url": "https://huggingface.co/datasets/xlangai/ubuntu_osworld_file_cache/resolve/main/thunderbird/dd84e895-72fd-4023-a336-97689ded257c/thunderbird-profile.tar.gz",
            "path": "C:\\Users\\Docker\\Downloads\\thunderbird-profile.tar.gz"
          }
        ]
      }
    },
    {
      "type": "prepare_thunderbird_profile",
      "parameters": {}
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility",
          "file:///C:/Users/Docker/Desktop/Quantum600EManual.pdf"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "thunderbird.exe",
          "-profile",
          "C:\\Users\\Docker\\AppData\\Roaming\\.thunderbird\\t5q2a5hp.default-release"
        ]
      }
    }
  ],
  "related_apps": [
    "settings",
    "chrome",
    "thunderbird"
  ],
  "evaluator": {
    "func": [
      "check_include_exclude",
      "check_thunderbird_email_composition"
    ],
    "conj": "and",
    "result": [
      {
        "type": "vm_command_line",
        "command": "powershell -NoProfile -Command \"$flags=[int](Get-ItemPropertyValue -Path 'HKCU:\\Control Panel\\Accessibility\\MouseKeys' -Name 'Flags' -ErrorAction SilentlyContinue); if (($flags -band 1) -eq 1) { Write-Output 'MOUSE_KEYS_ENABLED' } else { Write-Output 'MOUSE_KEYS_DISABLED' }\"",
        "shell": true
      },
      {
        "type": "vm_file",
        "path": "C:\\Users\\Docker\\AppData\\Roaming\\.thunderbird\\t5q2a5hp.default-release\\Mail\\Local Folders\\Drafts",
        "dest": "thunderbird-drafts.mbox"
      }
    ],
    "expected": [
      {
        "type": "rule",
        "rules": {
          "include": [
            "MOUSE_KEYS_ENABLED"
          ],
          "exclude": [
            "MOUSE_KEYS_DISABLED"
          ]
        }
      },
      {
        "type": "rule",
        "rules": {
          "to": "equipmentdesk@example.org",
          "subject": "Quantum 600E charging guidance",
          "body_points": [
            {
              "all_of": [
                [
                  "two",
                  "2"
                ],
                [
                  "batteries",
                  "battery"
                ]
              ]
            },
            [
              "12-volt",
              "12 volt"
            ],
            [
              "deep-cycle",
              "deep cycle"
            ],
            [
              "sealed"
            ],
            [
              "maintenance free",
              "maintenance-free"
            ],
            [
              "supplied off-board battery charger",
              "supplied charger",
              "off-board battery charger"
            ],
            [
              "Never use an extension cord",
              "do not use an extension cord",
              "no extension cord"
            ]
          ]
        }
      }
    ]
  },
  "proxy": false,
  "fixed_ip": false,
  "possibility_of_env_change": "low"
}
