{
  "id": "mobility-mouse_keys_google_maps_route",
  "user_group": "motor",
  "subgroup_ids": ["M-S2"],
  "category": "mobility",
  "need_ids": [
    "M4"
  ],
  "difficulty": "easy",
  "instruction": "Enable Windows Mouse Keys and keep them enabled. Use Google Maps to leave walking directions from London Victoria Station to Westminster Abbey visible.",
  "source": "synthetic",
  "gt_steps": [
    "Open Windows Settings.",
    "Select `Accessibility`.",
    "Open `Mouse` accessibility settings.",
    "Turn on `Mouse Keys`.",
    "Switch to the Google Maps tab in Chrome.",
    "Open the Directions interface.",
    "Set `London Victoria Station` as the starting location.",
    "Set `Westminster Abbey` as the destination.",
    "Select walking as the travel mode.",
    "Leave the walking directions open with Mouse Keys enabled."
  ],
  "config": [
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    },
    {
      "type": "chrome_open_tabs",
      "parameters": {
        "urls_to_open": [
          "https://www.google.com/maps"
        ]
      }
    },
    {
      "type": "activate_window",
      "parameters": {
        "window_name": "Google Chrome"
      }
    }
  ],
  "related_apps": [
    "settings",
    "chrome"
  ],
  "evaluator": {
    "func": [
      "check_include_exclude",
      "exact_match"
    ],
    "conj": "and",
    "result": [
      {
        "type": "vm_command_line",
        "command": "powershell -NoProfile -Command \"$flags=[int](Get-ItemPropertyValue -Path 'HKCU:\\Control Panel\\Accessibility\\MouseKeys' -Name 'Flags' -ErrorAction SilentlyContinue); if (($flags -band 1) -eq 1) { Write-Output 'MOUSE_KEYS_ENABLED' } else { Write-Output 'MOUSE_KEYS_DISABLED' }\"",
        "shell": true
      },
      {
        "type": "google_maps_state",
        "mode": "directions_walking",
        "required_text": [
          [
            "London Victoria Station",
            "Victoria Station"
          ],
          [
            "Westminster Abbey"
          ]
        ]
      }
    ],
    "expected": [
      {
        "type": "rule",
        "rules": {
          "include": [
            "MOUSE_KEYS_ENABLED"
          ],
          "exclude": [
            "MOUSE_KEYS_DISABLED"
          ]
        }
      },
      {
        "type": "rule",
        "rules": {
          "expected": "true"
        }
      }
    ]
  },
  "proxy": true,
  "possibility_of_env_change": "low"
}
