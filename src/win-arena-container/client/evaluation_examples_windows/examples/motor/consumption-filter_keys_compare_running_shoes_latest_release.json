{
  "id": "consumption-filter_keys_compare_running_shoes_latest_release",
  "_comment": "",
  "manually_evaluated": false,
  "snapshot": "chrome",
  "category": "consumption",
  "difficulty": "hard",
  "instruction": "Enable Windows Filter Keys and keep them enabled. Compare the release dates of `Salomon Men's Predict Soc2 Running` and `Nike Men's Stroke Running Shoe, 6.5 us`. For the more recently released shoe, select Black, size 12, and add exactly one unit to the shopping cart.",
  "source": "OneStopShop (self-hosted)",
  "gt_steps": [
    "Enable Windows Filter Keys.",
    "Keep Filter Keys enabled throughout the task.",
    "Open the OneStopShop website.",
    "Search for `Salomon Men's Predict Soc2 Running`.",
    "Open the product page.",
    "Click `Add to Compare`.",
    "Search for `Nike Men's Stroke Running Shoe, 6.5 us`.",
    "Open the product page.",
    "Click `Add to Compare`.",
    "Open the comparison page.",
    "Compare the release dates of the two shoes.",
    "Determine that `Salomon Men's Predict Soc2 Running` (SKU `B08Y2SN6Y4`) is the shoe with the more recent release date.",
    "Open the latest-release shoe if necessary.",
    "Select the Black colour.",
    "Select size 12.",
    "Leave the quantity as 1.",
    "Add the product to the shopping cart."
  ],
  "config": [
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    },
    {
      "type": "sleep",
      "parameters": {
        "seconds": 1
      }
    },
    {
      "type": "chrome_open_tabs",
      "parameters": {
        "urls_to_open": [
          "http://host.docker.internal:7770"
        ]
      }
    }
  ],
  "trajectory": "trajectories\\",
  "related_apps": [
    "settings",
    "chrome"
  ],
  "evaluator": {
    "func": [
      "check_include_exclude",
      "is_page_contains_items"
    ],
    "conj": "and",
    "result": [
      {
        "type": "vm_command_line",
        "command": "powershell -NoProfile -Command \"$flags=[int](Get-ItemPropertyValue -Path 'HKCU:\\Control Panel\\Accessibility\\Keyboard Response' -Name 'Flags' -ErrorAction SilentlyContinue); if (($flags -band 1) -eq 1) { Write-Output 'FILTER_KEYS_ENABLED' } else { Write-Output 'FILTER_KEYS_DISABLED' }\"",
        "shell": true
      },
      {
        "type": "page_info",
        "url": "http://host.docker.internal:7770/checkout/cart/",
        "load_state": "networkidle"
      }
    ],
    "expected": [
      {
        "type": "rule",
        "rules": {
          "include": [
            "FILTER_KEYS_ENABLED"
          ],
          "exclude": [
            "FILTER_KEYS_DISABLED"
          ]
        }
      },
      {
        "type": "rule",
        "rules": {
          "items": [
            {
              "sku": "B08Y2SN6Y4",
              "quantity": 1
            }
          ],
          "options": {
            "B08Y2SN6Y4": {
              "Color": "Black",
              "Size": "12"
            }
          }
        }
      }
    ]
  },
  "proxy": false,
  "fixed_ip": false,
  "possibility_of_env_change": "low"
}
