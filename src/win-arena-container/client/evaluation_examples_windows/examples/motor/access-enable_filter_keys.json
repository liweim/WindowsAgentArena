{
  "id": "access-enable_filter_keys",
  "manually_evaluated": true,
  "user_group": "motor",
  "subgroup_ids": ["M-S3"],
  "category": "access",
  "need_ids": [
    "M3"
  ],
  "difficulty": "easy",
  "instruction": "Enable Filter Keys and keep it enabled.",
  "source": "synthetic",
  "gt_steps": [
    "Open Windows settings.",
    "Navigate to Keyboard accessibility settings.",
    "Turn on the Filter Keys.",
    "Keep the Filter Keys enabled."
  ],
  "config": [],
  "related_apps": [
    "settings"
  ],
  "evaluator": {
    "func": "check_include_exclude",
    "result": {
      "type": "vm_command_line",
      "command": "powershell -NoProfile -Command \"$flags = [int](Get-ItemPropertyValue -Path 'HKCU:\\Control Panel\\Accessibility\\Keyboard Response' -Name 'Flags' -ErrorAction SilentlyContinue); if (($flags -band 1) -eq 1) { Write-Output 'FILTER_KEYS_ENABLED' } else { Write-Output 'FILTER_KEYS_DISABLED' }\"",
      "shell": true
    },
    "expected": {
      "type": "rule",
      "rules": {
        "include": [
          "FILTER_KEYS_ENABLED"
        ],
        "exclude": [
          "FILTER_KEYS_DISABLED"
        ]
      }
    }
  },
  "proxy": false,
  "possibility_of_env_change": "low"
}
