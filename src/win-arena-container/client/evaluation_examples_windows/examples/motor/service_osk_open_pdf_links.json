{
  "id": "service_osk_open_pdf_links",
  "_comment": "Put the answer to the `gt_steps`.",
  "snapshot": "chrome",
  "category": "service",
  "difficulty": "easy",
  "instruction": "Enable the Windows On-Screen Keyboard. The PDF is already open in Chrome. Open every website link contained in the PDF in new Chrome tabs and leave all of the opened tabs visible.",
  "source": "assets/ER_How_to_apply_online_final.pdf",
  "gt_steps": [
    "Enable the Windows On-Screen Keyboard.",
    "Return to the PDF already open in Chrome.",
    "Find every website link contained in the PDF.",
    "Open each website link in a new Chrome tab.",
    "Leave the opened website tab(s) open."
  ],
  "config": [
    {
      "type": "upload_file",
      "parameters": {
        "files": [
          {
            "local_path": "assets/ER_How_to_apply_online_final.pdf",
            "path": "C:\\Users\\Docker\\Downloads\\ER_How_to_apply_online_final.pdf"
          }
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility",
          "file:///C:/Users/Docker/Downloads/ER_How_to_apply_online_final.pdf"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    },
    {
      "type": "activate_window",
      "parameters": {
        "window_name": "Google Chrome"
      }
    }
  ],
  "trajectory": "trajectories\\",
  "related_apps": [
    "settings",
    "chrome"
  ],
  "evaluator": {
    "func": [
      "check_include_exclude",
      "is_expected_active_tab"
    ],
    "conj": "and",
    "result": [
      {
        "type": "vm_command_line",
        "command": "powershell -Command \"if (Get-Process osk -ErrorAction SilentlyContinue) { Write-Output 'OSK_OPEN' }\"",
        "shell": true
      },
      {
        "type": "active_tab_info",
        "goto_prefix": "https://"
      }
    ],
    "expected": [
      {
        "type": "rule",
        "rules": {
          "include": [
            "OSK_OPEN"
          ]
        }
      },
      {
        "type": "rule",
        "rules": {
          "type": "url",
          "url": "https://www.gov.uk/apply-for-photo-id-voter-authority-certificate"
        }
      }
    ]
  },
  "proxy": false,
  "fixed_ip": false,
  "possibility_of_env_change": "low"
}