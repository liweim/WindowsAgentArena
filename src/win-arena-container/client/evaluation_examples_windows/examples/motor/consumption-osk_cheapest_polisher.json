      },
      {
        "type": "is_file_saved_desktop",
        "filename": "cheapPolisher.txt",
        "textcontent": "6\" PALM POLISHER\n$19.99",
        "exact": true
      }
    ],
    "expected": [
      {
        "type": "rule",
        "rules": {
          "include": [
            "OSK_OPEN"
          ],
          "exclude": [
            "OSK_CLOSED"
          ]
        }
      },
      {
        "type": "rule",
        "rules": {
          "expected": "true"
        }
      }
