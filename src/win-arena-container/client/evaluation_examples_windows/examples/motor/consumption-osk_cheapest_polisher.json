{
  "id": "consumption-osk_cheapest_polisher",
  "_comment": "You need to specify how to connect the name and price; in other words, use \n to separate them.",
  "manually_evaluated": false,
  "snapshot": "chrome",
  "category": "consumption",
  "difficulty": "easy",
  "instruction": "Enable the Windows On-Screen Keyboard as a motor accessibility aid and keep it enabled throughout the task. The provided Harbor Freight catalog PDF is already open in Chrome. Find the cheapest polisher in the catalog. Write the full name of the polisher exactly as shown in the PDF, followed by its price, in a text file named `cheapPolisher.txt` on the Desktop.",
  "source": "assets/Nov2020Catalog_Full.pdf",
  "gt_steps": [
    "Enable the Windows On-Screen Keyboard.",
    "Keep the On-Screen Keyboard enabled throughout the task.",
    "Read the Harbor Freight catalog PDF already open in Chrome.",
    "Locate the polishing products section.",
    "Identify the cheapest polisher in the catalog.",
    "Find the product name `6\" PALM POLISHER`.",
    "Find its price `$19.99`.",
    "Open Notepad.",
    "Write the following exactly:",
    "6\" PALM POLISHER",
    "$19.99",
    "Save the file as `cheapPolisher.txt` on the Desktop.",
    "Leave the saved file on the Desktop.",
    "Leave the On-Screen Keyboard enabled."
