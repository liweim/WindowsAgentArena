{
  "id": "health-allied_health_form_download",
  "manually_evaluated": true,
  "operation_time": 97.28,
  "user_group": "motor",
  "subgroup_ids": ["M-S2"],
  "category": "health",
  "need_ids": [
    "M4"
  ],
  "difficulty": "medium",
  "instruction": "Enable Windows Mouse Keys and keep them enabled. Download the Allied Health Treatment Request form from the SIRA website and save the PDF on the Desktop as `answer.pdf`.",
  "source": "https://www.sira.nsw.gov.au/",
  "gt_steps": [
    "Open Windows Settings.",
    "Navigate to Accessibility.",
    "Open Mouse accessibility settings.",
    "Turn on Mouse Keys and keep it enabled.",
    "Open Google Chrome.",
    "Go to the SIRA website.",
    "Navigate through the SIRA website to find the Allied Health Treatment Request form by using search bar.",
    "Open the Allied Health Treatment Request form.",
    "Download the correct PDF form.",
    "Save the PDF on the Desktop as `answer.pdf`.",
    "Leave Mouse Keys enabled."
  ],
  "config": [
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility",
          "https://www.sira.nsw.gov.au/"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    },
    {
      "type": "activate_window",
      "parameters": {
        "window_name": "Google Chrome"
      }
    }
  ],
  "related_apps": [
    "settings",
    "chrome"
  ],
  "evaluator": {
    "func": [
      "check_include_exclude",
      "check_include_exclude"
    ],
    "conj": "and",
    "result": [
      {
        "type": "vm_command_line",
        "command": "powershell -NoProfile -Command \"$flags = [int](Get-ItemPropertyValue -Path 'HKCU:\\Control Panel\\Accessibility\\MouseKeys' -Name 'Flags' -ErrorAction SilentlyContinue); if (($flags -band 1) -eq 1) { Write-Output 'MOUSE_KEYS_ENABLED' } else { Write-Output 'MOUSE_KEYS_DISABLED' }\"",
        "shell": true
      },
      {
        "type": "vm_command_line",
        "command": "powershell -NoProfile -Command \"$file='C:\\Users\\Docker\\Desktop\\answer.pdf'; if (Test-Path $file) { Write-Output 'FILE_EXISTS' } else { Write-Output 'FILE_MISSING' }\"",
        "shell": true
      }
    ],
    "expected": [
      {
        "type": "rule",
        "rules": {
          "include": [
            "MOUSE_KEYS_ENABLED"
          ],
          "exclude": [
            "MOUSE_KEYS_DISABLED"
          ]
        }
      },
      {
        "type": "rule",
        "rules": {
          "include": [
            "FILE_EXISTS"
          ],
          "exclude": [
            "FILE_MISSING"
          ]
        }
      }
    ]
  },
  "proxy": true,
  "possibility_of_env_change": "medium"
