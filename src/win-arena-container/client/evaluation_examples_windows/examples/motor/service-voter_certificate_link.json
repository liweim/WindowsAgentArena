{
  "id": "service-voter_certificate_link",
  "_comment": "Put the answer to the `gt_steps`.",
  "category": "service",
  "need_ids": [
    "M1"
  ],
  "difficulty": "easy",
  "instruction": "Enable the Windows On-Screen Keyboard and keep it open. The PDF is already open in Chrome. Open the website link for the voter authority certificate application from the PDF in a new Chrome tab, leave that tab open, and leave the On-Screen Keyboard open.",
  "source": "synthetic",
  "gt_steps": [
    "Enable the Windows On-Screen Keyboard and keep it open.",
    "Return to the PDF already open in Chrome.",
    "Find the voter authority certificate application website link.",
    "Identify the link as `https://www.gov.uk/apply-for-photo-id-voter-authority-certificate`.",
    "Open the link in a new Chrome tab.",
    "Leave the linked website tab and the On-Screen Keyboard open."
  ],
  "config": [
    {
      "type": "upload_file",
      "parameters": {
        "files": [
          {
            "local_path": "assets/service-voter_certificate_link.pdf",
            "path": "C:\\Users\\Docker\\Downloads\\ER_How_to_apply_online_final.pdf"
          }
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility",
          "file:///C:/Users/Docker/Downloads/ER_How_to_apply_online_final.pdf"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    },
    {
      "type": "activate_window",
      "parameters": {
        "window_name": "Google Chrome"
      }
    }
  ],
  "related_apps": [
    "settings",
    "on_screen_keyboard",
    "chrome"
  ],
  "evaluator": {
    "func": [
      "check_include_exclude",
      "is_expected_active_tab"
    ],
    "conj": "and",
    "result": [
      {
        "type": "vm_command_line",
        "command": "powershell -Command \"if (Get-Process osk -ErrorAction SilentlyContinue) { Write-Output 'OSK_OPEN' }\"",
        "shell": true
      },
      {
        "type": "active_tab_info",
        "goto_prefix": "https://"
      }
    ],
    "expected": [
      {
        "type": "rule",
        "rules": {
          "include": [
            "OSK_OPEN"
          ]
        }
      },
      {
        "type": "rule",
        "rules": {
          "type": "url",
          "url": "https://www.gov.uk/apply-for-photo-id-voter-authority-certificate"
        }
      }
    ]
  },
  "proxy": true,
  "possibility_of_env_change": "low"
}
