{
  "id": "information-bookmark_accessibility_reference",
  "category": "information",
  "need_ids": [
    "M4"
  ],
  "difficulty": "easy",
  "instruction": "Enable Windows Mouse Keys and keep them enabled. Add the opened local Wikipedia `Accessibility` article to Chrome's bookmark bar.",
  "source": "http://host.docker.internal:8888/wikipedia_en_all_maxi_2022-05/A/Accessibility",
  "gt_steps": [
    "Enable Windows Mouse Keys.",
    "In Chrome, keep the opened local Wikipedia `Accessibility` article active.",
    "Add the current page as a Chrome bookmark.",
    "Save the bookmark with URL `http://host.docker.internal:8888/wikipedia_en_all_maxi_2022-05/A/Accessibility` in the Chrome bookmark bar.",
    "Leave Windows Mouse Keys enabled."
  ],
  "config": [
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    },
    {
      "type": "chrome_open_tabs",
      "parameters": {
        "urls_to_open": [
          "http://host.docker.internal:8888/wikipedia_en_all_maxi_2022-05/A/Accessibility"
        ]
      }
    }
  ],
  "related_apps": [
    "settings",
    "chrome"
  ],
  "evaluator": {
    "func": [
      "check_include_exclude",
      "is_expected_bookmarks"
    ],
    "conj": "and",
    "result": [
      {
        "type": "vm_command_line",
        "command": "powershell -NoProfile -Command \"$flags = [int](Get-ItemPropertyValue -Path 'HKCU:\\Control Panel\\Accessibility\\MouseKeys' -Name 'Flags'); if (($flags -band 1) -eq 1) { Write-Output 'MOUSE_KEYS_ENABLED' } else { Write-Output 'MOUSE_KEYS_DISABLED' }\"",
        "shell": true
      },
      {
        "type": "bookmarks"
      }
    ],
    "expected": [
      {
        "type": "rule",
        "rules": {
          "include": [
            "MOUSE_KEYS_ENABLED"
          ],
          "exclude": [
            "MOUSE_KEYS_DISABLED"
          ]
        }
      },
      {
        "type": "rule",
        "rules": {
          "type": "bookmark_bar_websites_urls",
          "urls": [
            "http://host.docker.internal:8888/wikipedia_en_all_maxi_2022-05/A/Accessibility"
          ]
        }
      }
    ]
  },
  "proxy": false,
  "possibility_of_env_change": "low"
}
