{
  "id": "management-mouse_keys_meeting_minutes_calendar",
  "_comment": "",
  "manually_evaluated": false,
  "snapshot": "windows",
  "category": "management",
  "difficulty": "easy",
  "instruction": "Enable Windows Mouse Keys as a motor accessibility aid and keep it enabled throughout the task. Open the meeting minutes PDF and find the place, date, and time of the next meeting. In the Thunderbird calendar, create a one-hour appointment starting at that date and time. Use the meeting place as the appointment title.",
  "source": "Local PDF: assets/meeting-minutes-sample.pdf",
  "gt_steps": [
    "Enable Windows Mouse Keys.",
    "Keep Mouse Keys enabled throughout the task.",
    "Open the meeting minutes PDF in Chrome.",
    "Locate the `Next Meeting` entry.",
    "Identify the next meeting place as `Tuck Le's place`.",
    "Identify the next meeting date as `30/8/08`.",
    "Identify the next meeting time as `10.00 am`.",
    "Open Thunderbird.",
    "Open the Thunderbird calendar.",
    "Create a new calendar event.",
    "Set the event title to `Tuck Le's place`.",
    "Set the start date and time to 30 August 2008 at 10:00 AM.",
    "Set the end date and time to 30 August 2008 at 11:00 AM.",
    "Save the calendar event.",
    "Keep Mouse Keys enabled."
  ],
  "config": [
    {
      "type": "upload_file",
      "parameters": {
        "files": [
          {
            "local_path": "assets/meeting-minutes-sample.pdf",
            "path": "C:\\Users\\Docker\\Desktop\\meeting-minutes-sample.pdf"
          }
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "thunderbird"
        ]
      }
    },
    {
      "type": "sleep",
      "parameters": {
        "seconds": 2
      }
    },
    {
      "type": "chrome_open_tabs",
      "parameters": {
        "urls_to_open": [
          "file:///C:/Users/Docker/Desktop/meeting-minutes-sample.pdf"
        ]
      }
    }
  ],
  "trajectory": "trajectories\\",
  "related_apps": [
    "settings",
    "chrome",
    "thunderbird"
  ],
  "evaluator": {
    "func": [
      "check_include_exclude",
      "check_thunderbird_calendar_event"
    ],
    "conj": "and",
    "result": [
      {
        "type": "vm_command_line",
        "command": "powershell -NoProfile -Command \"$flags=[int](Get-ItemPropertyValue -Path 'HKCU:\\Control Panel\\Accessibility\\MouseKeys' -Name 'Flags' -ErrorAction SilentlyContinue); if (($flags -band 1) -eq 1) { Write-Output 'MOUSE_KEYS_ENABLED' } else { Write-Output 'MOUSE_KEYS_DISABLED' }\"",
        "shell": true
      },
      {
        "type": "thunderbird_calendar"
      }
    ],
    "expected": [
      {
        "type": "rule",
        "rules": {
          "include": [
            "MOUSE_KEYS_ENABLED"
          ],
          "exclude": [
            "MOUSE_KEYS_DISABLED"
          ]
        }
      },
      {
        "type": "rule",
        "rules": {
          "title": "Tuck Le's place",
          "start": "2008-08-30T10:00:00",
          "end": "2008-08-30T11:00:00"
        }
      }
    ]
  },
  "proxy": false,
  "fixed_ip": false,
  "possibility_of_env_change": "low"
}