{
  "id": "chrome-accessibility-help-page",
  "snapshot": "chrome",
  "instruction": "Enable the On-Screen Keyboard. Using the On-Screen Keyboard, open Google Chrome and navigate to https://www.digital.nsw.gov.au/delivery/accessibility-and-inclusivity-toolkit. Leave the accessibility page open in the active tab.",
  "source": "https://abilitynet.org.uk/",
  "gt_steps": [
    "Enable the On-Screen Keyboard.",
    "Open Google Chrome.",
    "Place the cursor in the address bar.",
    "Type https://www.digital.nsw.gov.au/delivery/accessibility-and-inclusivity-toolkit using the On-Screen Keyboard.",
    "Press Enter to navigate to the website.",
    "Wait for the Accessibility and Inclusivity Toolkit page to load.",
    "Leave the page open in the active tab."
  ],
  "config": [
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--user-data-dir=/tmp/chrome-accessibility-help"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    }
  ],
  "trajectory": "trajectories/",
  "related_apps": [
    "chrome"
  ],
  "evaluator": {
    "func": "is_expected_url_pattern_match",
    "result": {
      "type": "active_tab_info_simple"
    },
    "expected": {
      "type": "rule",
      "rules": {
        "expected": [
          "https://digital.nsw.gov.au/delivery/accessibility-and-inclusivity-toolkit"
        ]
      }
    }
  }
}