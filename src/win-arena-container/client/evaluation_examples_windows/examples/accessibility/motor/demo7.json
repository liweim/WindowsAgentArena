{
  "id": "sticky-keys-sydney-weather",
  "snapshot": "chrome",
  "instruction": "Enable Sticky Keys and navigate to https://weatherzone.com.au/nsw/sydney/sydney in Google Chrome.",
  "source": "human",
  "config": [
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    }
  ],
  "trajectory": "trajectories/",
  "related_apps": [
    "chrome",
    "settings"
  ],
  "evaluator": {
    "func": "is_expected_active_tab",
    "result": {
      "type": "active_tab_info"
    },
    "expected": {
      "type": "rule",
      "rules": {
        "type": "url",
        "url": "https://weatherzone.com.au/nsw/sydney/sydney"
      }
    }
  },
  "proxy": true,
  "fixed_ip": false,
  "possibility_of_env_change": "low"
}