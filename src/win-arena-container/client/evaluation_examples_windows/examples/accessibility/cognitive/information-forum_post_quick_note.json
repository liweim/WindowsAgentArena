{
  "id": "information-forum_post_quick_note",
  "snapshot": "chrome",
  "category": "information",
  "difficulty": "medium",
  "instruction": "I would like to know how food manufacturers know the exact calories in each package. Use the forum to find the answer, then create `forum_post_note.txt` on the Desktop with the short answer.",
  "source": "WebArena self-hosted Reddit-style forum service: http://host.docker.internal:9999/f/explainlikeimfive",
  "gt_steps": [
    "Open the local forum Explain Like I'm Five community page in Google Chrome.",
    "Search or browse within the community for posts about calories in food packages.",
    "Open the post titled `ELI5: How do food manufacturers know for sure how many exact calories are in each package?`.",
    "Read the comments to find the short answer.",
    "Create `forum_post_note.txt` on the Desktop as an external memory aid.",
    "Write `They don't know exactly.`"
  ],
  "config": [
    {
      "type": "execute",
      "parameters": {
        "command": "powershell -NoProfile -Command \"$p=Join-Path $env:USERPROFILE 'Desktop\\forum_post_note.txt'; if(Test-Path $p){Remove-Item $p -Force}\"",
        "shell": true
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "cmd",
          "/c",
          "start chrome http://host.docker.internal:9999/forums"
        ]
      }
    }
  ],
  "trajectory": "trajectories\\",
  "related_apps": [
    "chrome",
    "notepad"
  ],
  "evaluator": {
    "func": "check_text_points",
    "result": {
      "type": "vm_command_line",
      "command": "powershell -NoProfile -Command \"$p=Join-Path $env:USERPROFILE 'Desktop\\forum_post_note.txt'; if(Test-Path $p){Get-Content $p -Raw}\"",
      "shell": true
    },
    "expected": {
      "type": "rule",
      "rules": {
        "ignore_case": true,
        "points": [
          [
            "don't know", "do not know"
          ]
        ]
      }
    }
  },
  "proxy": false,
  "fixed_ip": false,
  "possibility_of_env_change": "low"
}
