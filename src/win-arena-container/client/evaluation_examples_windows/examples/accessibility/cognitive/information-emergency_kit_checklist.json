    {
      "type": "execute",
      "parameters": {
        "command": [
          "powershell",
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "Start-Process 'shell:AppsFolder\\Microsoft.MicrosoftStickyNotes_8wekyb3d8bbwe!App'"
        ]
      }
    }
  ],
  "trajectory": "trajectories\\",
  "related_apps": [
    "msedge",
    "sticky_notes"
  ],
