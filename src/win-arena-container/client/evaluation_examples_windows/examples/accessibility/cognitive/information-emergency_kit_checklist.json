  "category": "information",
  "difficulty": "medium",
  "instruction": "Long emergency-preparation pages are hard to keep track of. Use Microsoft Edge Immersive Reader on the ready.gov emergency kit page. In Sticky Notes, write the first three basic emergency supplies listed on the page. Copy the item names exactly.",
  "source": "https://www.ready.gov/kit",
  "gt_steps": [
    "Open the ready.gov emergency kit page in Microsoft Edge.",
    "Use Immersive Reader to simplify the page.",
    "Find the Basic Disaster Supplies Kit list.",
    "Open Sticky Notes.",
    "Create a note.",
    "Write the first three listed item names exactly: `Water`, `Food`, and `Battery-powered or hand crank radio and a NOAA Weather Radio with tone alert`."
  ],
  "config": [
    {
      "type": "launch",
      "parameters": {
