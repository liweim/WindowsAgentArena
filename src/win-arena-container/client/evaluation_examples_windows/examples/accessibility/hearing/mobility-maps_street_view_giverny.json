{
  "id": "mobility-maps_street_view_giverny",
  "snapshot": "chrome",
  "category": "mobility",
  "difficulty": "easy",
  "instruction": "The scenic spot in the video looks beautiful. Turn on Chrome Live Caption, find out what it is, then open Google Maps and look around it in Street View.",
  "source": "https://www.youtube.com/watch?v=UZvi7K32qGw",
  "gt_steps": [
    "Enable Chrome Live Caption.",
    "Watch the YouTube video and identify `Giverny, France` from the captions.",
    "Open Google Maps.",
    "Search for `Giverny, France`.",
    "Drag Pegman onto the map near Giverny, France."
  ],
  "config": [
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    },
    {
      "type": "chrome_prepare_youtube_for_live_caption",
      "parameters": {
        "url": "https://www.youtube.com/watch?v=UZvi7K32qGw",
        "wait_seconds": 1
      }
    },
    {
      "type": "activate_window",
      "parameters": {
        "window_name": "Google Chrome"
      }
    }
  ],
  "trajectory": "trajectories\\",
  "related_apps": [
    "chrome"
  ],
  "evaluator": {
    "func": [
      "exact_match",
      "exact_match"
    ],
    "conj": "and",
    "result": [
      {
        "type": "youtube_captions_enabled",
        "url": "https://www.youtube.com/watch?v=UZvi7K32qGw"
      },
      {
        "type": "google_maps_state",
        "mode": "street_view",
        "required_text": [
          "Giverny, France"
        ]
      }
    ],
    "expected": [
      {
        "type": "rule",
        "rules": {
          "expected": "true"
        }
      },
      {
        "type": "rule",
        "rules": {
          "expected": "true"
        }
      }
    ]
  }
}
