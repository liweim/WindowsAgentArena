{
  "id": "Information-child_visit_preparation",
  "snapshot": "chrome",
  "category": "Information",
  "difficulty": "hard",
  "instruction": "Enable Chrome Live Caption, watch the video, and enter the specific comfort items, clothing choices, or appointment actions recommended in the video into the spreadsheet. Use one row per phrase in the `items` column. Each answer should contain the complete phrase exactly as it appears in the captions.",
  "source": "https://www.youtube.com/watch?v=2BuJuk4BQIs",
  "gt_steps": [
    "Open the child visit preparation video in Chrome.",
    "Turn on Chrome Live Caption.",
    "Play the video and use Live Caption to identify the recommended comfort items, clothing choices, or appointment actions.",
    "Open `items.xlsx` from the Desktop.",
    "Fill the `items` column with one phrase per row: `short sleeve shirt`, `easy to remove`, `holding and talking`, `breastfeeding`, `favourite toy`, `music`, `book`, `bandage`, `reward`, `vaccination record`, `15 minutes`.",
    "Save the completed spreadsheet."
  ],
  "config": [
    {
      "type": "upload_file",
      "parameters": {
        "files": [
          {
            "local_path": "assets/items.xlsx",
            "path": "C:\\Users\\Docker\\Desktop\\items.xlsx"
          }
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    },
    {
      "type": "chrome_prepare_youtube_for_live_caption",
      "parameters": {
        "url": "https://www.youtube.com/watch?v=2BuJuk4BQIs",
        "wait_seconds": 1
      }
    },
    {
      "type": "open",
      "parameters": {
        "path": "C:\\Users\\Docker\\Desktop\\items.xlsx"
      }
    },
    {
      "type": "activate_window",
      "parameters": {
        "window_name": "Google Chrome"
      }
    }
  ],
  "trajectory": "trajectories\\",
  "related_apps": [
    "chrome",
    "libreoffice_calc"
  ],
  "evaluator": {
    "func": "compare_xlsx_items",
    "result": {
      "type": "vm_file",
      "path": "C:\\Users\\Docker\\Desktop\\items.xlsx",
      "dest": "items.xlsx"
    },
    "expected": {
      "type": "rule",
      "rules": {
        "column_name": "items",
        "expected": [
          "short sleeve shirt",
          "easy to remove",
          "holding and talking",
          "breastfeeding",
          "favourite toy",
          "music",
          "book",
          "bandage",
          "reward",
          "vaccination record",
          "15 minutes"
        ]
      }
    }
  }
}
