{
  "id": "Information-child_visit_preparation",
  "snapshot": "chrome",
  "category": "Information",
  "difficulty": "hard",
  "instruction": "Enable Chrome Live Caption, watch the video, and write the specific comfort items, clothing choices, or appointment actions recommended in the video in a sticky note. Each answer should contain the complete phrase exactly as it appears in the captions.",
  "source": "https://www.youtube.com/watch?v=2BuJuk4BQIs",
  "gt_steps": [
    "Open the child visit preparation video in Chrome.",
    "Turn on Chrome Live Caption.",
    "Play the video and use Live Caption to identify the recommended comfort items, clothing choices, or appointment actions.",
    "Open Sticky Notes.",
    "Write the phrases in a sticky note: `short sleeve shirt`, `easy to remove`, `holding and talking`, `breastfeeding`, `favourite toy`, `music`, `book`, `bandage`, `reward`, `vaccination record`, `15 minutes`."
  ],
  "config": [
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    },
    {
      "type": "chrome_prepare_youtube_for_live_caption",
      "parameters": {
        "url": "https://www.youtube.com/watch?v=2BuJuk4BQIs",
        "wait_seconds": 1
      }
    },
    {
      "type": "execute",
      "parameters": {
        "command": [
          "powershell",
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "Start-Process 'shell:AppsFolder\\Microsoft.MicrosoftStickyNotes_8wekyb3d8bbwe!App'"
        ]
      }
    },
    {
      "type": "activate_window",
      "parameters": {
        "window_name": "Google Chrome"
      }
    }
  ],
  "trajectory": "trajectories\\",
  "related_apps": [
    "chrome",
    "sticky_notes"
  ],
  "evaluator": {
    "func": "check_text_points",
    "result": {
      "type": "sticky_notes_content"
    },
    "expected": {
      "type": "rule",
      "rules": {
        "ignore_case": true,
        "points": [
          [
            "short sleeve shirt"
          ],
          [
            "easy to remove"
          ],
          [
            "holding and talking"
          ],
          [
            "breastfeeding"
          ],
          [
            "favourite toy"
          ],
          [
            "music"
          ],
          [
            "book"
          ],
          [
            "bandage"
          ],
          [
            "reward"
          ],
          [
            "vaccination record"
          ],
          [
            "15 minutes"
          ]
        ]
      }
    }
  }
}
