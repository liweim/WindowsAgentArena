{
  "id": "Information-fema_emergency_kit",
  "snapshot": "chrome",
  "category": "Information",
  "difficulty": "hard",
  "instruction": "Enable Chrome Live Caption, watch the video, and enter each must-have emergency kit item mentioned in the video into `~/Desktop/items.xlsx`. Use one row per phrase in the `items` column. Each answer should contain the complete phrase exactly as it appears in the captions.",
  "source": "https://www.youtube.com/watch?v=o4enqHGluLI",
  "gt_steps": [
    "Open the FEMA emergency kit video in Chrome.",
    "Turn on Chrome Live Caption.",
    "Play the video and use Live Caption to identify the must-have emergency kit items.",
    "Open `items.xlsx` from the Desktop.",
    "Fill the `items` column with one item per row: `water`, `food`, `manual can opener`, `flashlight`, `extra batteries`, `weather radio`, `hand-cranked radio`, `first aid kit`, `diapers`, `infant formula`, `medicine bottles`, `children`, `pets`, `extra food`, `collapsible bowls`, `medicine`, `prescriptions`, `over-the-counter medications`.",
    "Save the completed spreadsheet."
  ],
  "config": [
    {
      "type": "upload_file",
      "parameters": {
        "files": [
          {
            "local_path": "assets/items.xlsx",
            "path": "C:\\Users\\Docker\\Desktop\\items.xlsx"
          }
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    },
    {
      "type": "chrome_prepare_youtube_for_live_caption",
      "parameters": {
        "url": "https://www.youtube.com/watch?v=o4enqHGluLI",
        "wait_seconds": 1
      }
    },
    {
      "type": "open",
      "parameters": {
        "path": "C:\\Users\\Docker\\Desktop\\items.xlsx"
      }
    },
    {
      "type": "activate_window",
      "parameters": {
        "window_name": "Google Chrome"
      }
    }
  ],
  "trajectory": "trajectories\\",
  "related_apps": [
    "chrome",
    "libreoffice_calc"
  ],
  "evaluator": {
    "func": "compare_xlsx_items",
    "result": {
      "type": "vm_file",
      "path": "C:\\Users\\Docker\\Desktop\\items.xlsx",
      "dest": "items.xlsx"
    },
    "expected": {
      "type": "rule",
      "rules": {
        "column_name": "items",
        "expected": [
          "water",
          "food",
          "manual can opener",
          "flashlight",
          "extra batteries",
          "weather radio",
          "hand-cranked radio",
          "first aid kit",
          "diapers",
          "infant formula",
          "medicine bottles",
          "children",
          "pets",
          "extra food",
          "collapsible bowls",
          "medicine",
          "prescriptions",
          "over-the-counter medications"
        ]
      }
    }
  }
}
