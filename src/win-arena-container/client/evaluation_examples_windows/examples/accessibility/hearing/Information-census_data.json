{
  "id": "Information-census_data",
  "snapshot": "chrome",
  "category": "Information",
  "instruction": "Turn on Live Caption, watch the opened YouTube video, then open the Census data website and search for the area demonstrated in the video.",
  "source": "https://www.youtube.com/watch?v=6eqpPRLndPk",
  "gt_steps": [
    "Turn on Chrome Live Caption.",
    "Play the video and identify the website shown in the video.",
    "Open https://data.census.gov/.",
    "Click the website search box.",
    "Enter `Maricopa County, Arizona`.",
    "Submit the search.",
    "Stay on the search results page."
  ],
  "config": [
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    },
    {
      "type": "chrome_prepare_youtube_for_live_caption",
      "parameters": {
        "url": "https://www.youtube.com/watch?v=6eqpPRLndPk",
        "wait_seconds": 1
      }
    },
    {
      "type": "activate_window",
      "parameters": {
        "window_name": "Google Chrome"
      }
    }
  ],
  "trajectory": "trajectories\\",
  "related_apps": [
    "chrome"
  ],
  "evaluator": {
    "func": [
      "exact_match",
      "exact_match"
    ],
    "conj": "and",
    "result": [
      {
        "type": "youtube_captions_enabled",
        "url": "https://www.youtube.com/watch?v=6eqpPRLndPk"
      },
      {
        "type": "active_tab_contains_text",
        "url_contains": "data.census.gov",
        "expected_text": "Maricopa County, Arizona"
      }
    ],
    "expected": [
      {
        "type": "rule",
        "rules": {
          "expected": "true"
        }
      },
      {
        "type": "rule",
        "rules": {
          "expected": "true"
        }
      }
    ]
  }
}
