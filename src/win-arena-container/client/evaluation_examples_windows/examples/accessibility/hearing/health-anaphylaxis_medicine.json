{
  "id": "health-anaphylaxis_medicine",
  "snapshot": "chrome",
  "category": "Health",
  "difficulty": "medium",
  "instruction": "I have anaphylaxis and need to know what medicine to take. Turn on captions in the opened YouTube video, then watch it and save the answer in `answer.txt` on the Desktop.",
  "source": "https://youtu.be/1YrKVobZnNg",
  "gt_steps": [
    "Turn on captions in the YouTube player.",
    "Play the video and use the YouTube captions to identify the medicine needed for anaphylaxis.",
    "Create answer.txt on the Desktop.",
    "Write `epinephrine` in answer.txt.",
    "Save and close answer.txt."
  ],
  "config": [
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    },
    {
      "type": "chrome_prepare_youtube_for_live_caption",
      "parameters": {
        "url": "https://youtu.be/1YrKVobZnNg",
        "wait_seconds": 1
      }
    },
    {
      "type": "activate_window",
      "parameters": {
        "window_name": "Google Chrome"
      }
    }
  ],
  "trajectory": "trajectories\\",
  "related_apps": [
    "chrome"
  ],
  "evaluator": {
    "func": [
      "exact_match",
      "exact_match"
    ],
    "conj": "and",
    "result": [
      {
        "type": "youtube_captions_enabled",
        "url": "https://youtu.be/1YrKVobZnNg"
      },
      {
        "type": "is_file_saved_desktop",
        "filename": "answer.txt",
        "textcontent": "epinephrine"
      }
    ],
    "expected": [
      {
        "type": "rule",
        "rules": {
          "expected": "true"
        }
      },
      {
        "type": "rule",
        "rules": {
          "expected": "true"
        }
      }
    ]
  }
}
