{
  "id": "mobility-maps_navigation_fish_market",
  "snapshot": "chrome",
  "category": "Mobility",
  "difficulty": "medium",
  "instruction": "I’m at Sydney Central Station and I want to go to the place mentioned in the video. Turn on Chrome Live Caption, identify the destination, find the driving route, then open Google Maps and start navigation",
  "source": "https://www.youtube.com/watch?v=M06i_wiKzYU",
  "gt_steps": [
    "Enable Chrome Live Caption.",
    "Watch the YouTube video and identify `Sydney Fish Market` from the captions.",
    "Open Google Maps.",
    "Search for `Sydney Fish Market`.",
    "Click Directions.",
    "Set the start location to `Sydney Central Station`.",
    "Keep driving mode selected."
  ],
  "config": [
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    },
    {
      "type": "chrome_prepare_youtube_for_live_caption",
      "parameters": {
        "url": "https://www.youtube.com/watch?v=M06i_wiKzYU",
        "wait_seconds": 1
      }
    },
    {
      "type": "activate_window",
      "parameters": {
        "window_name": "Google Chrome"
      }
    }
  ],
  "trajectory": "trajectories\\",
  "related_apps": [
    "chrome"
  ],
  "evaluator": {
    "func": [
      "exact_match",
      "exact_match"
    ],
    "conj": "and",
    "result": [
      {
        "type": "youtube_captions_enabled",
        "url": "https://www.youtube.com/watch?v=M06i_wiKzYU"
      },
      {
        "type": "google_maps_state",
        "mode": "directions_driving",
        "required_text": [
          [
            "Sydney Fish Market"
          ],
          [
            "Sydney Central Station",
            "Central Station"
          ]
        ]
      }
    ],
    "expected": [
      {
        "type": "rule",
        "rules": {
          "expected": "true"
        }
      },
      {
        "type": "rule",
        "rules": {
          "expected": "true"
        }
      }
    ]
  }
}
