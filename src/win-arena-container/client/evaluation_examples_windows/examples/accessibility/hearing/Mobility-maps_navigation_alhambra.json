{
  "id": "Mobility-maps_navigation_alhambra",
  "snapshot": "chrome",
  "category": "Mobility",
  "instruction": "I’m at Granada Train Station and I want to walk to the place mentioned in the video. Turn on Chrome Live Caption, identify the destination, find the route, then open Google Maps and start navigation there.",
  "source": "https://www.youtube.com/watch?v=iEseJViidy8",
  "gt_steps": [
    "Enable Chrome Live Caption.",
    "Watch the YouTube video and identify `Alhambra Palace` from the captions.",
    "Open Google Maps.",
    "Search for `Alhambra Palace`.",
    "Click Directions.",
    "Set the start location to `Granada Train Station`.",
    "Keep walking mode selected."
  ],
  "config": [
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    },
    {
      "type": "chrome_prepare_youtube_for_live_caption",
      "parameters": {
        "url": "https://www.youtube.com/watch?v=iEseJViidy8",
        "wait_seconds": 1
      }
    },
    {
      "type": "activate_window",
      "parameters": {
        "window_name": "Google Chrome"
      }
    }
  ],
  "trajectory": "trajectories\\",
  "related_apps": [
    "chrome"
  ],
  "evaluator": {
    "func": [
      "exact_match",
      "exact_match"
    ],
    "conj": "and",
    "result": [
      {
        "type": "youtube_captions_enabled",
        "url": "https://www.youtube.com/watch?v=iEseJViidy8"
      },
      {
        "type": "google_maps_state",
        "mode": "directions_walking",
        "required_text": [
          [
            "Alhambra Palace",
            "Alhambra"
          ],
          [
            "Granada Train Station",
            "Granada, Av. de Andaluces",
            "Av. de Andaluces"
          ]
        ]
      }
    ],
    "expected": [
      {
        "type": "rule",
        "rules": {
          "expected": "true"
        }
      },
      {
        "type": "rule",
        "rules": {
          "expected": "true"
        }
      }
    ]
  }
}
