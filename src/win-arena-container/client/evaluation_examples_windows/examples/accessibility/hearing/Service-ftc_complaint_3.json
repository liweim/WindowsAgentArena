{
  "id": "Service-ftc_complaint_3",
  "snapshot": "chrome",
  "category": "Service",
  "instruction": "Turn on Live Caption in Chrome, then use the video on the opened FTC page to answer this question: what personal financial information did the scammer ask for in the fake job opportunity example? Save only the answer in a text file named answer.txt on the Desktop.",
  "source": "https://consumer.ftc.gov/media/video-0054-how-file-complaint-federal-trade-commission",
  "gt_steps": [
    "Open chrome://settings/accessibility.",
    "Turn on Live Caption.",
    "Play the video and use Live Caption to identify the personal financial information requested in the fake job opportunity example.",
    "Create answer.txt on the Desktop.",
    "Write `bank account number` in answer.txt.",
    "Save and close answer.txt."
  ],
  "config": [
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    },
    {
      "type": "chrome_open_tabs",
      "parameters": {
        "urls_to_open": [
          "https://consumer.ftc.gov/media/video-0054-how-file-complaint-federal-trade-commission"
        ]
      }
    },
    {
      "type": "activate_window",
      "parameters": {
        "window_name": "Google Chrome"
      }
    }
  ],
  "trajectory": "trajectories\\",
  "related_apps": [
    "chrome"
  ],
  "evaluator": {
    "func": [
      "exact_match",
      "exact_match"
    ],
    "conj": "and",
    "result": [
      {
        "type": "live_caption_enabled"
      },
      {
        "type": "is_file_saved_desktop",
        "filename": "answer.txt",
        "textcontent": "bank account number"
      }
    ],
    "expected": [
      {
        "type": "rule",
        "rules": {
          "expected": "true"
        }
      },
      {
        "type": "rule",
        "rules": {
          "expected": "true"
        }
      }
    ]
  }
}
