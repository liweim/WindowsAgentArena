{
  "id": "health-ibuprofen_acetaminophen_together",
  "snapshot": "chrome",
  "category": "health",
  "difficulty": "easy",
  "instruction": "I am considering taking ibuprofen and acetaminophen and need to know whether they can be taken together. Turn on captions in the opened YouTube video, then watch it and save the answer in `answer.txt` on the Desktop.",
  "source": "https://www.youtube.com/watch?v=2324zMLFYC8",
  "gt_steps": [
    "Turn on captions in the YouTube player.",
    "Play the video and use the YouTube captions to determine whether ibuprofen and acetaminophen can be taken together.",
    "Create answer.txt on the Desktop.",
    "Write `yes` in answer.txt.",
    "Save and close answer.txt."
  ],
  "config": [
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    },
    {
      "type": "chrome_prepare_youtube_for_live_caption",
      "parameters": {
        "url": "https://www.youtube.com/watch?v=2324zMLFYC8",
        "wait_seconds": 1
      }
    },
    {
      "type": "activate_window",
      "parameters": {
        "window_name": "Google Chrome"
      }
    }
  ],
  "trajectory": "trajectories\\",
  "related_apps": [
    "chrome"
  ],
  "evaluator": {
    "func": [
      "exact_match",
      "exact_match"
    ],
    "conj": "and",
    "result": [
      {
        "type": "youtube_captions_enabled",
        "url": "https://www.youtube.com/watch?v=2324zMLFYC8"
      },
      {
        "type": "is_file_saved_desktop",
        "filename": "answer.txt",
        "textcontent": "yes"
      }
    ],
    "expected": [
      {
        "type": "rule",
        "rules": {
          "expected": "true"
        }
      },
      {
        "type": "rule",
        "rules": {
          "expected": "true"
        }
      }
    ]
  }
}
