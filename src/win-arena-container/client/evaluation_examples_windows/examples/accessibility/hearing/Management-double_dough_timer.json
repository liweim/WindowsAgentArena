{
  "id": "Management-double_dough_timer",
  "snapshot": "chrome",
  "category": "Management",
  "difficulty": "medium",
  "instruction": "Enable Windows Live Captions, watch the video, determine about how long the pita dough should take to double in size, then open the Windows Clock app and create a timer for that duration. Leave the timer visible in the Clock app.",
  "source": "https://www.youtube.com/watch?v=NPiA69p4gqE",
  "gt_steps": [
    "Turn on Windows Live captions.",
    "Watch the YouTube video and use the live captions to determine that the pita dough should take 2h to double in size.",
    "Open the Windows Clock app.",
    "Create and start a 2h timer.",
    "Leave the timer visible in the Clock app."
  ],
  "config": [
    {
        "type": "launch",
        "parameters": {
            "command": [
                "start",
                "ms-clock://Timers"
            ]
        }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    },
    {
      "type": "chrome_prepare_youtube_for_live_caption",
      "parameters": {
        "url": "https://www.youtube.com/watch?v=NPiA69p4gqE",
        "wait_seconds": 1
      }
    },
    {
      "type": "activate_window",
      "parameters": {
        "window_name": "Google Chrome"
      }
    }
  ],
  "trajectory": "trajectories\\",
  "related_apps": [
    "chrome",
    "clock"
  ],
  "evaluator": {
    "postconfig": [
        {
            "type": "activate_window",
            "parameters": {
                "window_name": "Clock",
                "strict": true
            }
        },
        {
            "type": "sleep",
            "parameters": {
                "seconds": 0.5
            }
        }
    ],
    "func": "exact_match",
    "result": {
      "type": "check_if_timer_started",
      "hours": 0,
      "minutes": 120,
      "seconds": 0
    },
    "expected": {
      "type": "rule",
      "rules": {
        "expected": "True"
      }
    }
  }
}
