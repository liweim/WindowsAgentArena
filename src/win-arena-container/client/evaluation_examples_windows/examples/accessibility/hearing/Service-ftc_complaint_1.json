{
  "id": "Service-ftc_complaint_1",
  "snapshot": "chrome",
  "category": "Service",
  "instruction": "Turn on Live Caption in Chrome, then use the video on the opened FTC page to answer this question: where does the video say victims should go to file a complaint online? Open that complaint page in Chrome.",
  "source": "https://consumer.ftc.gov/media/video-0054-how-file-complaint-federal-trade-commission",
  "gt_steps": [
    "Open chrome://settings/accessibility.",
    "Turn on Live Caption.",
    "Play the video and use Live Caption to identify where victims should go to file a complaint online.",
    "Open https://ftc.gov/complaint."
  ],
  "config": [
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    },
    {
      "type": "chrome_open_tabs",
      "parameters": {
        "urls_to_open": [
          "https://consumer.ftc.gov/media/video-0054-how-file-complaint-federal-trade-commission"
        ]
      }
    },
    {
      "type": "activate_window",
      "parameters": {
        "window_name": "Google Chrome"
      }
    }
  ],
  "trajectory": "trajectories\\",
  "related_apps": [
    "chrome"
  ],
  "evaluator": {
    "func": [
      "exact_match",
      "is_expected_active_tab"
    ],
    "conj": "and",
    "result": [
      {
        "type": "live_caption_enabled"
      },
      {
        "type": "active_tab_info",
        "goto_prefix": "https://"
      }
    ],
    "expected": [
      {
        "type": "rule",
        "rules": {
          "expected": "true"
        }
      },
      {
        "type": "rule",
        "rules": {
          "type": "url",
          "url": "https://reportfraud.ftc.gov"
        }
      }
    ]
  }
}
