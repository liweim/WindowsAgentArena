{
  "id": "turn_on_chrome_live_caption",
  "snapshot": "chrome",
  "instruction": "I have trouble hearing audio in videos unless subtitles are available. Please turn on Live Caption in Chrome for me.",
  "source": "chrome://settings/accessibility > Live Caption",
  "_comments": "Accessibility hearing task: force Live Caption off before launch, then require the agent to enable it.",
  "config": [
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    }
  ],
  "trajectory": "trajectories\\",
  "related_apps": [
    "chrome"
  ],
  "evaluator": {
    "func": "exact_match",
    "result": {
      "type": "live_caption_enabled"
    },
    "expected": {
      "type": "rule",
      "rules": {
        "expected": "true"
      }
    }
  }
}
