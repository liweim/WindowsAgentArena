{
  "id": "health-allergy_medication",
  "snapshot": "chrome",
  "category": "Health",
  "difficulty": "hard",
  "instruction": "I have allergies and need to know what medicine to take. Open Chrome Live Caption, watch the video, and write the recommended medication name in `answer.txt` on the Desktop.",
  "source": "https://medlineplus.gov/ency/videos/mov/200094_eng.mp4",
  "gt_steps": [
    "Open the MedlinePlus allergy video in Chrome.",
    "Turn on Chrome Live Caption.",
    "Play the video and use Live Caption to identify the recommended medication for allergies.",
    "Create answer.txt on the Desktop.",
    "Write `antihistamines` in answer.txt.",
    "Save and close answer.txt."
  ],
  "config": [
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility",
          "https://medlineplus.gov/ency/videos/mov/200094_eng.mp4"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    },
    {
      "type": "chrome_pause_video",
      "parameters": {
        "url": "https://medlineplus.gov/ency/videos/mov/200094_eng.mp4",
        "wait_seconds": 1
      }
    },
    {
      "type": "activate_window",
      "parameters": {
        "window_name": "Google Chrome"
      }
    }
  ],
  "trajectory": "trajectories\\",
  "related_apps": [
    "chrome"
  ],
  "evaluator": {
    "func": [
      "exact_match",
      "exact_match"
    ],
    "conj": "and",
    "result": [
      {
        "type": "live_caption_enabled"
      },
      {
        "type": "is_file_saved_desktop",
        "filename": "answer.txt",
        "textcontent": "antihistamines"
      }
    ],
    "expected": [
      {
        "type": "rule",
        "rules": {
          "expected": "true"
        }
      },
      {
        "type": "rule",
        "rules": {
          "expected": "true"
        }
      }
    ]
  }
}
