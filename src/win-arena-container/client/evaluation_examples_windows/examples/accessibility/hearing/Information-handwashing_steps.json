{
  "id": "Information-handwashing_steps",
  "snapshot": "chrome",
  "category": "Information",
  "difficulty": "hard",
  "instruction": "Enable Chrome Live Caption, watch the video, and enter the hand-washing steps mentioned in the video into the spreadsheet. Use one row per phrase in the `items` column. Each answer should contain the complete phrase exactly as it appears in the captions.",
  "source": "https://www.youtube.com/watch?v=UitUdTjhZz8",
  "gt_steps": [
    "Open the hand-washing video in Chrome.",
    "Turn on Chrome Live Caption.",
    "Play the video and use Live Caption to identify the hand-washing steps.",
    "Open `items.xlsx` from the Desktop.",
    "Fill the `items` column with one phrase per row: `warm water`, `soap`, `front and back`, `between your fingers`, `rinse and dry`.",
    "Save the completed spreadsheet."
  ],
  "config": [
    {
      "type": "upload_file",
      "parameters": {
        "files": [
          {
            "local_path": "assets/items.xlsx",
            "path": "C:\\Users\\Docker\\Desktop\\items.xlsx"
          }
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    },
    {
      "type": "chrome_prepare_youtube_for_live_caption",
      "parameters": {
        "url": "https://www.youtube.com/watch?v=UitUdTjhZz8",
        "wait_seconds": 1
      }
    },
    {
      "type": "open",
      "parameters": {
        "path": "C:\\Users\\Docker\\Desktop\\items.xlsx"
      }
    },
    {
      "type": "activate_window",
      "parameters": {
        "window_name": "Google Chrome"
      }
    }
  ],
  "trajectory": "trajectories\\",
  "related_apps": [
    "chrome",
    "libreoffice_calc"
  ],
  "evaluator": {
    "func": "compare_xlsx_items",
    "result": {
      "type": "vm_file",
      "path": "C:\\Users\\Docker\\Desktop\\items.xlsx",
      "dest": "items.xlsx"
    },
    "expected": {
      "type": "rule",
      "rules": {
        "column_name": "items",
        "expected": [
          "warm water",
          "soap",
          "front and back",
          "between your fingers",
          "rinse and dry"
        ]
      }
    }
  }
}
