{
  "id": "Information-handwashing_steps",
  "snapshot": "chrome",
  "category": "Information",
  "difficulty": "hard",
  "instruction": "Enable Chrome Live Caption, watch the video, and write the hand-washing steps mentioned in the video in a sticky note. Each answer should contain the complete phrase exactly as it appears in the captions.",
  "source": "https://www.youtube.com/watch?v=UitUdTjhZz8",
  "gt_steps": [
    "Open the hand-washing video in Chrome.",
    "Turn on Chrome Live Caption.",
    "Play the video and use Live Caption to identify the hand-washing steps.",
    "Open Sticky Notes.",
    "Write the phrases in a sticky note: `warm water`, `soap`, `front and back`, `between your fingers`, `rinse and dry`."
  ],
  "config": [
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    },
    {
      "type": "chrome_prepare_youtube_for_live_caption",
      "parameters": {
        "url": "https://www.youtube.com/watch?v=UitUdTjhZz8",
        "wait_seconds": 1
      }
    },
    {
      "type": "execute",
      "parameters": {
        "command": [
          "powershell",
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "Start-Process 'shell:AppsFolder\\Microsoft.MicrosoftStickyNotes_8wekyb3d8bbwe!App'"
        ]
      }
    },
    {
      "type": "activate_window",
      "parameters": {
        "window_name": "Google Chrome"
      }
    }
  ],
  "trajectory": "trajectories\\",
  "related_apps": [
    "chrome",
    "sticky_notes"
  ],
  "evaluator": {
    "func": "check_text_points",
    "result": {
      "type": "sticky_notes_content"
    },
    "expected": {
      "type": "rule",
      "rules": {
        "ignore_case": true,
        "points": [
          [
            "warm water"
          ],
          [
            "soap"
          ],
          [
            "front and back"
          ],
          [
            "between your fingers"
          ],
          [
            "rinse and dry"
          ]
        ]
      }
    }
  }
}
