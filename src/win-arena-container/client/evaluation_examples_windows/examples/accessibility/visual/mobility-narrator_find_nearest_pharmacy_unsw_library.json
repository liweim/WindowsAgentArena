  "_comment": "Allow personal data like UNSW",
  "manually_evaluated": false,
  "snapshot": "chrome",
  "category": "mobility",
  "difficulty": "easy",
  "instruction": "Turn on a screen reader. Use it to navigate Google Maps and find the nearest pharmacy to the UNSW Main Library. Open the place details for the nearest pharmacy and leave the place details open.",
  "source": "synthetic",
  "gt_steps": [
    "Open Google Maps in Chrome.",
    "Turn on Windows Narrator.",
