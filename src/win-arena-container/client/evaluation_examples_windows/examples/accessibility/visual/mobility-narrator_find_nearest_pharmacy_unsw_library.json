    {
      "type": "sleep",
      "parameters": {
        "seconds": 1
      }
    },
    {
      "type": "chrome_open_tabs",
      "parameters": {
        "urls_to_open": [
          "https://www.google.com/maps"
        ]
      }
    }
  ],
  "trajectory": "trajectories\\",
  "related_apps": [
    "chrome",
    "basic_os"
  ],
  "evaluator": {
    "func": [
      "check_narrator_enabled",
      "exact_match"
    ],
    "conj": "and",
    "result": [
      {
        "type": "narrator_status"
      },
      {
        "type": "google_maps_state",
        "mode": "place_details",
        "required_text": [
          [
            "Pharmacy at UNSW"
          ]
        ]
      }
    ],
    "expected": [
      {
        "type": "rule",
        "rules": {}
      },
      {
        "type": "rule",
        "rules": {
          "expected": "true"
        }
      }
    ]
  },
  "proxy": false,
  "fixed_ip": false,
  "possibility_of_env_change": "low"
}