{
  "id": "access-high-contrast-task1",
  "snapshot": "windows",
  "category": "access",
  "difficulty": "easy",
  "instruction": "Enable High Contrast mode to Aquatic. Open Google Chrome and navigate to https://www.abc.net.au/news. Leave the ABC News homepage open with High Contrast mode enabled.",
  "source": "human",
  "gt_steps": [
    "Open Windows Settings.",
    "Navigate to Accessibility settings.",
    "Open Contrast Themes settings.",
    "Enable a High Contrast theme to Aquatic.",
    "Apply the theme and wait for it to take effect.",
    "Open Google Chrome.",
    "Navigate to https://www.abc.net.au/news.",
    "Wait for the ABC News homepage to load.",
    "Leave the homepage open."
  ],
  "config": [
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--user-data-dir=/tmp/chrome-high-contrast-abc"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    }
  ],
  "trajectory": "trajectories/",
  "related_apps": [
    "settings",
    "chrome"
  ],
  "evaluator": {
    "func": "check_include_exclude",
    "result": {
      "type": "vm_command_line",
      "command": "reg query \"HKCU\\Control Panel\\Accessibility\\HighContrast\" /v Flags",
      "shell": true
    },
    "expected": {
      "type": "rule",
      "rules": {
        "include": [
          "127"
        ],
        "exclude": []
      }
    }
  },
  "proxy": false,
  "fixed_ip": false,
  "possibility_of_env_change": "low"
}
