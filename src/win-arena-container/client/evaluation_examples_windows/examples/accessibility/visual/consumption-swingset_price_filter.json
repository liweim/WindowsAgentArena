{
  "id": "consumption-swingset_price_filter",
  "_comment": "Use the self-hosted shopping service, since the data is more stable.",
  "snapshot": "chrome",
  "category": "consumption",
  "difficulty": "easy",
  "instruction": "Turn on Window Narrator from Accessibility Setting. Open https://www.smythstoys.com/, and search for swing set under 49.99 pounds. Leave the search result page open",
  "source": "https://www.jbidigital.co.uk/blog/jbis-5-favourite-examples-of-accessible-and-inaccessible-websites/",
  "gt_steps": [
    "Enable Window's Narrator.",
    "Open https://www.smythstoys.com/",
    "Find swing set",
    "Filter the price to be under 49.99 pounds",
    "Leave the search result page open in the active tab."
  ],
  "config": [
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility",
          "https://www.smythstoys.com/"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    },
    {
      "type": "activate_window",
      "parameters": {
        "window_name": "Google Chrome"
      }
    }
  ],
  "trajectory": "trajectories\\",
  "related_apps": [
    "chrome"
  ],
  "evaluator": {
    "func": [
      "check_narrator_enabled",
      "is_expected_url_pattern_match"
    ],
    "conj": "and",
    "result": [
      {
        "type": "narrator_status"
      },
      {
        "type": "active_tab_info_simple"
      }
    ],
    "expected": [
      {
        "type": "rule",
        "rules": {}
      },
      {
        "type": "rule",
        "rules": {
          "expected": [
            "https?://(www\\.)?smythstoys\\.com/.*/swings-and-slides/.*",
            "priceRange",
            "49\\.99"
          ]
        }
      }
    ]
  }
}
