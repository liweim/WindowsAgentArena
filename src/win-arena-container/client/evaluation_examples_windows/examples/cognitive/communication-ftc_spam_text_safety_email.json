{
  "id": "communication-ftc_spam_text_safety_email",
  "category": "communication",
  "difficulty": "medium",
  "instruction": "Draft a Thunderbird email to `family@example.org` with subject `Spam text safety` using Microsoft Edge Immersive Reader to read the FTC guidance. Include the three safety phrases exactly as written on the page and save the draft without sending it.",
  "source": "https://consumer.ftc.gov/articles/how-recognize-and-report-spam-text-messages",
  "gt_steps": [
    "Switch to the FTC spam text guidance in Microsoft Edge.",
    "With the article active in Microsoft Edge, press `F9` to enter Immersive Reader.",
    "Scroll to `What To Do About Spam Text Messages`.",
    "Switch to Thunderbird.",
    "Create a new email draft.",
    "Set the recipient to `family@example.org`.",
    "Set the subject to `Spam text safety`.",
    "Enter the following message body:\n`don't click on any links`\n`contact the company using a phone number or website you know is real`\n`Not the information in the text message`",
    "Save the email as a draft without sending it."
  ],
  "config": [
    {
      "type": "launch",
      "parameters": {
        "command": [
          "cmd",
          "/c",
          "start msedge https://consumer.ftc.gov/articles/how-recognize-and-report-spam-text-messages"
        ]
      }
    },
    {
      "type": "download",
      "parameters": {
        "files": [
          {
            "url": "https://huggingface.co/datasets/xlangai/ubuntu_osworld_file_cache/resolve/main/thunderbird/dd84e895-72fd-4023-a336-97689ded257c/thunderbird-profile.tar.gz",
            "path": "C:\\Users\\Docker\\Downloads\\thunderbird-profile.tar.gz"
          }
        ]
      }
    },
    {
      "type": "prepare_thunderbird_profile",
      "parameters": {}
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "thunderbird.exe",
          "-profile",
          "C:\\Users\\Docker\\AppData\\Roaming\\.thunderbird\\t5q2a5hp.default-release"
        ]
      }
    }
  ],
  "related_apps": [
    "msedge",
    "thunderbird"
  ],
  "evaluator": {
    "func": [
      "check_thunderbird_email_composition",
      "check_edge_immersive_reader_state"
    ],
    "conj": "and",
    "result": [
      {
        "type": "vm_file",
        "path": "C:\\Users\\Docker\\AppData\\Roaming\\.thunderbird\\t5q2a5hp.default-release\\Mail\\Local Folders\\Drafts",
        "dest": "thunderbird-drafts.mbox"
      },
      {
        "type": "edge_immersive_reader_state",
        "activate_edge": true
      }
    ],
    "expected": [
      {
        "type": "rule",
        "rules": {
          "to": "family@example.org",
          "subject": "Spam text safety",
          "body_points": [
            [
              "don't click on any links"
            ],
            [
              "contact the company using a phone number or website you know is real"
            ],
            [
              "Not the information in the text message"
            ]
          ]
        }
      },
      {
        "type": "rule",
        "rules": {
          "reader_mode_open": true
        }
      }
    ]
  },
  "proxy": false,
  "fixed_ip": false,
  "possibility_of_env_change": "low"
}
