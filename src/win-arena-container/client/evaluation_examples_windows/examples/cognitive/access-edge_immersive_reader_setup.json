{
  "id": "access-edge_immersive_reader_setup",
  "user_group": "cognitive",
  "subgroup_ids": ["C-S1"],
  "category": "access",
  "need_ids": [
    "C1"
  ],
  "difficulty": "medium",
  "instruction": "Set up the Guardian entertainment guide in Microsoft Edge for reading in Immersive Reader with one-line focus turned on.",
  "source": "https://www.theguardian.com/culture/2026/jun/27/entertainment-guide-week-ahead-supergirl-silo-jackass-life-larry-pursuit-unhappiness",
  "gt_steps": [
    "Open the `More actions (...)` menu in Microsoft Edge.",
    "Activate `Immersive Reader`.",
    "Open `Reading preferences`.",
    "Turn on `Line focus`.",
    "Select the one-line focus option."
  ],
  "config": [
    {
      "type": "launch",
      "parameters": {
        "command": [
          "cmd",
          "/c",
          "start msedge https://www.theguardian.com/culture/2026/jun/27/entertainment-guide-week-ahead-supergirl-silo-jackass-life-larry-pursuit-unhappiness"
        ]
      }
    }
  ],
  "related_apps": [
    "msedge"
  ],
  "evaluator": {
    "func": "check_edge_immersive_reader_state",
    "result": {
      "type": "edge_immersive_reader_state"
    },
    "expected": {
      "type": "rule",
      "rules": {
        "reader_mode_open": true,
        "line_focus_visible": true,
        "one_line_focus_visible": true,
        "one_line_focus_selected": true
      }
    }
  },
  "proxy": true,
  "possibility_of_env_change": "low"
}
