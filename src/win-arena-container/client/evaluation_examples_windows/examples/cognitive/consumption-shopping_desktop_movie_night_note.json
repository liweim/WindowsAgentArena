{
  "id": "consumption-shopping_desktop_movie_night_note",
  "snapshot": "chrome",
  "category": "consumption",
  "difficulty": "medium",
  "instruction": "Use the movie-night shopping reminder on the Desktop to add everything still needed to the shopping cart.",
  "source": "WebArena self-hosted OneStopShop service",
  "gt_steps": [
    "Open `movie_night_note.txt` on the Desktop.",
    "Read the shopping reminder.",
    "Open the self-hosted shopping website.",
    "Add one bagged microwave popcorn product to the shopping cart.",
    "Add one canned root beer product to the shopping cart.",
    "Add one plain pretzel sticks product to the shopping cart.",
    "Add one sea-salt potato chips product to the shopping cart.",
    "Add one SpongeBob gummy patties product to the shopping cart."
  ],
  "config": [
    {
      "type": "execute",
      "parameters": {
        "command": "powershell -NoProfile -Command \"Set-Content -Path (Join-Path $env:USERPROFILE 'Desktop\\movie_night_note.txt') -Value @('Plan: casual movie night at home.','Please buy only the missing snacks and drink:','- bagged microwave popcorn','- canned root beer','- plain pretzel sticks','- sea-salt potato chips','- SpongeBob gummy patties')\"",
        "shell": true
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    },
    {
      "type": "sleep",
      "parameters": {
        "seconds": 1
      }
    },
    {
      "type": "reset_shopping_cart",
      "parameters": {}
    },
    {
      "type": "chrome_open_tabs",
      "parameters": {
        "urls_to_open": [
          "http://host.docker.internal:7770"
        ]
      }
    }
  ],
  "trajectory": "trajectories\\",
  "related_apps": [
    "chrome",
    "notepad"
  ],
  "evaluator": {
    "func": "is_page_contains_items",
