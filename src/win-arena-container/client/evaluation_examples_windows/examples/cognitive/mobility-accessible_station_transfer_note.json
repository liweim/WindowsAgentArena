{
  "id": "mobility-accessible_station_transfer_note",
  "category": "mobility",
  "difficulty": "medium",
  "instruction": "Use the Central Station local area and station guide saved locally on the Desktop to plan a step-free transfer from Platform 23 to the L2/L3 light rail stop at Central Chalmers Street. Create a Sticky Note with the starting platform, light-rail stop and lines, required exit, stair-only route to avoid, and the map's accessibility guidance.",
  "source": "https://transportnsw.info/document/7272/central-area-guide.pdf",
  "gt_steps": [
    "Open Sticky Notes.",
    "Create a new note.",
    "Enter the following text:\n`Start: Platform 23\nLight rail: Central Chalmers Street - L2/L3\nExit: Exit 5 Chalmers St\nAvoid: Eastern Stairs\nAccessibility: Follow the blue signs for lifts and accessible paths`",
    "Keep the completed note saved in Sticky Notes."
  ],
  "config": [
    {
      "type": "upload_file",
      "parameters": {
        "files": [
          {
            "local_path": "assets/mobility-accessible_station_transfer_note.pdf",
            "path": "C:\\Users\\Docker\\Desktop\\CentralStationGuide.pdf"
          }
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "msedge",
          "file:///C:/Users/Docker/Desktop/CentralStationGuide.pdf"
        ]
      }
    }
  ],
  "related_apps": [
    "msedge",
    "sticky_notes"
  ],
  "evaluator": {
    "func": "check_text_points",
    "result": {
      "type": "sticky_notes_content"
    },
    "expected": {
      "type": "rule",
      "rules": {
        "ignore_case": true,
        "points": [
          [
            "Platform 23"
          ],
          [
            "Central Chalmers Street"
          ],
          [
            "L2/L3",
            "L2 / L3",
            "L2 and L3"
          ],
          [
            "Exit 5",
            "Exit 5 Chalmers St",
            "Exit 5 Chalmers Street"
          ],
          [
            "Eastern Stairs"
          ],
          [
            "blue signs"
          ],
          [
            "lifts and accessible paths"
          ]
        ]
      }
    }
  },
  "proxy": false,
  "fixed_ip": false,
  "possibility_of_env_change": "medium"
}
