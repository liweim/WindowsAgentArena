  "operation_time": 0,
  "instruction": "Create a Sticky Note containing the page's two section headings about taking action on and reporting spam text messages, exactly as written and in webpage order. Use Immersive Reader to read the page.",
  "source": "https://consumer.ftc.gov/articles/how-recognize-and-report-spam-text-messages",
  "gt_steps": [
    "Open the FTC spam text message guidance page in Microsoft Edge.",
    "Activate Immersive Reader.",
    "Locate the two section headings about taking action on and reporting spam text messages.",
    "Open Sticky Notes.",
    "Create a new note.",
    "Enter exactly `What To Do About Spam Text Messages\nHow To Report Spam Text Messages` in the note, one item per line."
  ],
  "config": [
    {
      "type": "launch",
      "parameters": {
        "command": [
          "cmd",
          "/c",
          "start msedge https://consumer.ftc.gov/articles/how-recognize-and-report-spam-text-messages"
        ]
      }
    },
    {
      "type": "execute",
      "parameters": {
        "command": [
          "powershell",
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "Start-Process 'shell:AppsFolder\\Microsoft.MicrosoftStickyNotes_8wekyb3d8bbwe!App'"
        ]
      }
    }
  ],
  "related_apps": [
    "msedge",
    "sticky_notes"
  ],
  "evaluator": {
    "func": [
      "check_text_points",
      "check_edge_immersive_reader_state"
    ],
    "conj": "and",
    "result": [
