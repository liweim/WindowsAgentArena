{
  "id": "service-cfpb_automatic_payment_stop_answer",
  "snapshot": "msedge",
  "category": "service",
  "difficulty": "medium",
  "instruction": "Write the CFPB's steps for stopping automatic payments from a bank account in `answer.txt` on the Desktop, using the page's original wording and Immersive Reader to read the guidance.",
  "source": "https://www.consumerfinance.gov/ask-cfpb/how-do-i-stop-automatic-payments-from-my-bank-account-en-2023/",
  "gt_steps": [
    "Open the CFPB page about stopping automatic payments from a bank account in Microsoft Edge.",
    "Activate Immersive Reader.",
    "Locate the section about stopping automatic debits.",
    "Open Notepad.",
    "Create `answer.txt` on the Desktop.",
    "Enter `Call and write the company` in the file.",
    "Add `Call and write your bank or credit union` to the file.",
    "Add `Monitor your accounts` to the file.",
    "Save `answer.txt`."
  ],
  "config": [
    {
      "type": "launch",
      "parameters": {
        "command": [
          "cmd",
          "/c",
          "start msedge https://www.consumerfinance.gov/ask-cfpb/how-do-i-stop-automatic-payments-from-my-bank-account-en-2023/"
        ]
      }
    }
  ],
  "trajectory": "trajectories\\",
  "related_apps": [
    "msedge",
    "notepad"
  ],
  "evaluator": {
    "func": [
      "check_text_points",
      "check_edge_immersive_reader_state"
    ],
    "conj": "and",
    "result": [
      {
        "type": "vm_command_line",
        "command": "powershell -NoProfile -Command \"$p=Join-Path $env:USERPROFILE 'Desktop\\answer.txt'; if(Test-Path $p){Get-Content $p -Raw}\"",
        "shell": true
      },
      {
        "type": "edge_immersive_reader_state",
        "activate_edge": true
      }
    ],
    "expected": [
      {
        "type": "rule",
        "rules": {
          "ignore_case": true,
          "points": [
            [
              "Call and write the company"
            ],
            [
              "Call and write your bank or credit union"
            ],
            [
              "Monitor your accounts"
            ]
          ]
        }
      },
      {
        "type": "rule",
        "rules": {
          "reader_mode_open": true
        }
      }
    ]
  },
  "proxy": false,
  "fixed_ip": false,
  "possibility_of_env_change": "low"
}
