{
  "id": "consumption-elsa_water_bottle",
  "category": "consumption",
  "need_ids": [
    "C2",
    "C6"
  ],
  "difficulty": "easy",
  "instruction": "Use the shopping reminder on the Desktop to add the matching water bottle to the cart.",
  "source": "http://host.docker.internal:7770",
  "gt_steps": [
    "Open `water_bottle_reminder.txt` on the Desktop and identify the requested product details.",
    "Open the self-hosted shopping website.",
    "Find `Disney Frozen 2 Elsa 24 oz. Tritan Water Bottle`.",
    "Add the matching product to the shopping cart."
  ],
  "config": [
    {
      "type": "execute",
      "parameters": {
        "command": "powershell -NoProfile -Command \"Set-Content -Path (Join-Path $env:USERPROFILE 'Desktop\\water_bottle_reminder.txt') -Value @('School bottle reminder:','- Disney Frozen 2','- Elsa','- 24 oz','- Tritan')\"",
        "shell": true
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    },
    {
      "type": "sleep",
      "parameters": {
        "seconds": 1
      }
    },
    {
      "type": "reset_shopping_cart",
      "parameters": {}
    },
    {
      "type": "chrome_open_tabs",
      "parameters": {
        "urls_to_open": [
          "http://host.docker.internal:7770"
        ]
      }
    }
  ],
  "related_apps": [
    "chrome",
    "notepad"
  ],
  "evaluator": {
    "func": "is_page_contains_items",
    "result": {
      "type": "page_info",
      "url": "http://host.docker.internal:7770/checkout/cart/",
      "load_state": "networkidle"
    },
    "expected": {
      "type": "rule",
      "rules": {
        "items": [
          "B09LMSGJW6"
        ]
      }
    }
  },
  "proxy": false,
  "possibility_of_env_change": "low"
}
