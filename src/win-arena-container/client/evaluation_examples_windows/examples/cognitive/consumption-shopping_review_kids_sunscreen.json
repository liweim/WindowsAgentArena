{
  "id": "consumption-shopping_review_kids_sunscreen",
  "snapshot": "chrome",
  "category": "consumption",
  "difficulty": "hard",
  "instruction": "I'm looking for a kids sunscreen that doesn't sting and doesn't feel sticky. Check the OneStopShop customer reviews and add the matching product to the cart.",
  "source": "WebArena self-hosted OneStopShop service",
  "gt_steps": [
    "Open the self-hosted shopping website.",
    "Search for kids sunscreen products.",
    "Compare the customer reviews for stinging and sticky-feel feedback.",
    "Identify `Banana Boat Kids Vanishing Color, Amazing Apple and Berry Blast Reef Frienfly Broad Spectrum Mineral Sunscreen Foam Twin Pack (Apple & Berry), SPF 50, 4oz. Each` as the standard answer.",
    "Open the standard-answer product.",
    "Add the product to the shopping cart."
  ],
  "config": [
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    },
    {
      "type": "sleep",
      "parameters": {
        "seconds": 1
      }
    },
    {
      "type": "reset_shopping_cart",
      "parameters": {}
    },
    {
      "type": "chrome_open_tabs",
      "parameters": {
        "urls_to_open": [
          "http://host.docker.internal:7770"
        ]
      }
    }
  ],
  "trajectory": "trajectories\\",
  "related_apps": [
    "chrome"
  ],
  "evaluator": {
    "func": "is_page_contains_items",
    "result": {
      "type": "page_info",
      "url": "http://host.docker.internal:7770/checkout/cart/",
      "load_state": "networkidle"
    },
    "expected": {
      "type": "rule",
      "rules": {
        "items": [
          "B08Q3S3SNF"
        ]
      }
    }
  },
  "proxy": false,
  "fixed_ip": false,
  "possibility_of_env_change": "low"
}
