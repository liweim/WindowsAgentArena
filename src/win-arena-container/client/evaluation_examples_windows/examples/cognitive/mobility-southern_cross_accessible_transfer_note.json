{
  "id": "mobility-southern_cross_accessible_transfer_note",
  "category": "mobility",
  "difficulty": "hard",
  "instruction": "Use the Southern Cross Station precinct map saved locally on the Desktop to plan a step-free transfer from Platforms 3A-4A to the Coach Terminal via Bourke Street Bridge. Create a Sticky Note with the arrival platform group, transfer level, the lift used for step-free vertical movement, destination, and the street shown along the Coach Terminal side of the station.",
  "source": "https://edge.sitecorecloud.io/stategovernc45d-cftw-production-c9ca/media/Project/TransportWebsite/TransportWebsite/News-and-resources/Maps/station-precinct/Southern-Cross-Station-precinct-map.pdf",
  "gt_steps": [
    "Open Sticky Notes.",
    "Create a new note.",
    "Enter the following text:\n`Arrival: Platforms 3A-4A\nTransfer level: Bourke Street Bridge\nAccessibility: Lift\nDestination: Coach Terminal\nCoach Terminal side: Spencer Street`",
    "Keep the completed note saved in Sticky Notes."
  ],
  "config": [
