      "type": "upload_file",
      "parameters": {
        "files": [
          {
            "local_path": "assets/mobility-southern_cross_accessible_transfer_note.pdf",
            "path": "C:\\Users\\Docker\\Desktop\\SouthernCrossStationMap.pdf"
          }
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "msedge",
          "file:///C:/Users/Docker/Desktop/SouthernCrossStationMap.pdf"
        ]
      }
    }
  ],
  "related_apps": [
    "msedge",
    "sticky_notes"
  ],
