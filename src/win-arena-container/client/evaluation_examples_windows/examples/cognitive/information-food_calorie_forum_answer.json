{
  "id": "information-food_calorie_forum_answer",
  "category": "information",
  "need_ids": [
    "C1",
    "C6"
  ],
  "difficulty": "medium",
  "instruction": "The forum discussion is long. Find the thread about how food manufacturers know the calories in each package and write a one-sentence plain-language takeaway in `answer.txt` on the Desktop.",
  "source": "http://host.docker.internal:9999/f/explainlikeimfive",
  "gt_steps": [
    "Open the local Explain Like I'm Five forum and find the calorie-package discussion.",
    "Read enough of the discussion to identify the main takeaway.",
    "Write a single plain-language sentence conveying that manufacturers do not know the exact calories and instead estimate them.",
    "Save it as `answer.txt` on the Desktop."
  ],
  "config": [
    {
      "type": "execute",
      "parameters": {
        "command": "powershell -NoProfile -Command \"$p=Join-Path $env:USERPROFILE 'Desktop\\answer.txt'; if(Test-Path $p){Remove-Item $p -Force}\"",
        "shell": true
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "cmd",
          "/c",
          "start chrome http://host.docker.internal:9999/forums"
        ]
      }
    }
  ],
  "related_apps": [
    "chrome",
    "notepad"
  ],
  "evaluator": {
    "func": "check_text_points",
    "result": {
      "type": "vm_command_line",
      "command": "powershell -NoProfile -Command \"$p=Join-Path $env:USERPROFILE 'Desktop\\answer.txt'; if(Test-Path $p){Get-Content $p -Raw}\"",
      "shell": true
    },
    "expected": {
      "type": "rule",
      "rules": {
        "ignore_case": true,
        "points": [
          [
            "don't know exactly",
            "do not know exactly",
            "cannot know exactly",
            "can't know exactly",
            "they estimate",
            "they calculate an estimate",
            "not known exactly"
          ]
        ]
      }
    }
  },
  "proxy": false,
  "possibility_of_env_change": "low"
}
