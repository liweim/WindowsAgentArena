{
  "id": "consumption-tomato_egg_stir_fry",
  "user_group": "cognitive",
  "subgroup_ids": ["C-S2", "C-S3"],
  "category": "consumption",
  "need_ids": [
    "C2",
    "C4"
  ],
  "difficulty": "medium",
  "instruction": "Use the meal shopping note on the Desktop to add only the still-needed ingredients to the cart.",
  "source": "http://host.docker.internal:7770",
  "gt_steps": [
    "Open `meal_shopping_note.txt` and determine which ingredients are still needed.",
    "Open the self-hosted shopping website.",
    "Add an ordinary chicken egg product to the cart.",
    "Add a plain tomato product suitable for the dish to the cart."
  ],
  "config": [
    {
      "type": "execute",
      "parameters": {
        "command": "powershell -NoProfile -Command \"Set-Content -Path (Join-Path $env:USERPROFILE 'Desktop\\meal_shopping_note.txt') -Value @('Dinner: tomato-and-egg stir-fry','Already have: cooking oil, salt, sugar, and other seasonings','Still need the two core fresh ingredients.')\"",
        "shell": true
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    },
    {
      "type": "sleep",
      "parameters": {
        "seconds": 1
      }
    },
    {
      "type": "reset_shopping_cart",
      "parameters": {}
    },
    {
      "type": "chrome_open_tabs",
      "parameters": {
        "urls_to_open": [
          "http://host.docker.internal:7770"
        ]
      }
    }
  ],
  "related_apps": [
    "chrome",
    "notepad"
  ],
  "evaluator": {
    "func": "is_page_contains_items",
    "result": {
      "type": "page_info",
      "url": "http://host.docker.internal:7770/checkout/cart/",
      "load_state": "networkidle"
    },
    "expected": {
      "type": "rule",
      "rules": {
        "item_groups": [
          [
            "B07ZS7FJ9Y",
            "B092H4XZKY",
            "B078158XZ4"
          ],
          [
            "B074H577S3",
