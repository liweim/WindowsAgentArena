{
  "id": "consumption-lowest_price_white_mouse",
  "user_group": "cognitive",
  "subgroup_ids": ["C-S2", "C-S3"],
  "category": "consumption",
  "need_ids": [
    "C2",
    "C5"
  ],
  "difficulty": "medium",
  "instruction": "Use the mouse shopping reminder on the Desktop to choose the matching product and add it to the cart.",
  "source": "http://host.docker.internal:7770",
  "gt_steps": [
    "Open `mouse_shopping_reminder.txt` and read the requirements.",
    "Search the shopping site for wireless mouse products.",
    "Compare standalone white options and choose the lowest-priced match.",
    "Select the White option and add the matching mouse to the cart."
  ],
  "config": [
    {
      "type": "execute",
      "parameters": {
        "command": "powershell -NoProfile -Command \"Set-Content -Path (Join-Path $env:USERPROFILE 'Desktop\\mouse_shopping_reminder.txt') -Value @('Mouse requirements:','- wireless','- white','- standalone mouse, not a bundle','- choose the lowest-priced match')\"",
        "shell": true
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    },
    {
      "type": "sleep",
      "parameters": {
        "seconds": 1
      }
    },
    {
      "type": "reset_shopping_cart",
      "parameters": {}
    },
    {
      "type": "chrome_open_tabs",
      "parameters": {
        "urls_to_open": [
          "http://host.docker.internal:7770"
        ]
      }
    }
  ],
  "related_apps": [
    "chrome",
    "notepad"
  ],
  "evaluator": {
    "func": "is_page_contains_items",
    "result": {
      "type": "page_info",
      "url": "http://host.docker.internal:7770/checkout/cart/",
      "load_state": "networkidle"
    },
    "expected": {
      "type": "rule",
      "rules": {
        "items": [
          "B09443ZWQD"
        ],
        "options": {
          "B09443ZWQD": {
            "Color": "White"
          }
        }
      }
    }
  },
  "proxy": false,
  "possibility_of_env_change": "low"
}
