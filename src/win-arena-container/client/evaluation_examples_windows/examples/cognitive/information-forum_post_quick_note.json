{
  "id": "information-forum_post_quick_note",
  "snapshot": "chrome",
  "category": "information",
  "difficulty": "medium",
  "instruction": "Find out from the forum how food manufacturers know the exact calories in each package, and write a short answer in `forum_post_note.txt` on the Desktop.",
  "source": "WebArena self-hosted Reddit-style forum service: http://host.docker.internal:9999/f/explainlikeimfive",
  "gt_steps": [
    "Open the local Explain Like I'm Five forum in Google Chrome.",
    "Search for the post about how food manufacturers know the calories in each package.",
    "Open `ELI5: How do food manufacturers know for sure how many exact calories are in each package?`.",
    "Read the comments for the short answer.",
    "Open Notepad.",
    "Create `forum_post_note.txt` on the Desktop.",
    "Enter the standard answer `They don't know exactly.` in the file.",
    "Save `forum_post_note.txt`."
  ],
  "config": [
    {
      "type": "execute",
      "parameters": {
        "command": "powershell -NoProfile -Command \"$p=Join-Path $env:USERPROFILE 'Desktop\\forum_post_note.txt'; if(Test-Path $p){Remove-Item $p -Force}\"",
        "shell": true
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "cmd",
          "/c",
          "start chrome http://host.docker.internal:9999/forums"
        ]
      }
    }
  ],
  "trajectory": "trajectories\\",
  "related_apps": [
    "chrome",
    "notepad"
  ],
  "evaluator": {
    "func": "check_text_points",
    "result": {
      "type": "vm_command_line",
      "command": "powershell -NoProfile -Command \"$p=Join-Path $env:USERPROFILE 'Desktop\\forum_post_note.txt'; if(Test-Path $p){Get-Content $p -Raw}\"",
      "shell": true
    },
    "expected": {
      "type": "rule",
      "rules": {
        "ignore_case": true,
        "points": [
          [
            "don't know",
            "do not know"
          ]
        ]
      }
    }
  },
  "proxy": false,
  "fixed_ip": false,
  "possibility_of_env_change": "low"
}
