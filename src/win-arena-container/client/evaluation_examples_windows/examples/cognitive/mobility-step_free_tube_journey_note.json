{
  "id": "mobility-step_free_tube_journey_note",
  "category": "mobility",
  "difficulty": "hard",
  "instruction": "Use the TfL Step-free Tube guide saved locally on the Desktop to turn its Woodside Park-to-Green Park example into `answer.txt`. Record the southbound starting entrance, first line and direction, interchange station and platform, second line and direction, and final exit method, one item per line in that order.",
  "source": "https://content.tfl.gov.uk/step-free-tube-guide-map.pdf",
  "gt_steps": [
    "Open Notepad.",
    "Enter the following text:\n`Woodside Park entrance\nNorthern line southbound (Morden via Bank branch)\nEuston - platform 6\nVictoria line southbound\nGreen Park - exit via lifts`",
    "Save the file as `answer.txt` on the Desktop."
  ],
  "config": [
    {
      "type": "upload_file",
      "parameters": {
        "files": [
          {
            "local_path": "assets/mobility-step_free_tube_journey_note.pdf",
            "path": "C:\\Users\\Docker\\Desktop\\TfLStepFreeTubeGuide.pdf"
          }
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "msedge",
          "file:///C:/Users/Docker/Desktop/TfLStepFreeTubeGuide.pdf"
        ]
      }
    }
  ],
  "related_apps": [
    "msedge",
    "notepad"
  ],
  "evaluator": {
    "func": "check_text_points",
    "result": {
      "type": "desktop_file_text",
      "filename": "answer.txt"
    },
    "expected": {
      "type": "rule",
      "rules": {
        "ignore_case": true,
        "ordered": true,
        "line_based": true,
        "points": [
          {
            "all_of": [
              [
                "Woodside Park"
              ],
              [
                "entrance"
              ]
            ]
          },
          {
            "all_of": [
              [
                "Northern line"
              ],
              [
                "southbound"
              ],
              [
                "Morden via Bank",
                "via Bank"
              ]
            ]
          },
          {
            "all_of": [
              [
                "Euston"
              ],
              [
                "platform 6",
                "platform six"
              ]
            ]
          },
          {
            "all_of": [
              [
                "Victoria line"
              ],
              [
                "southbound"
              ]
            ]
          },
          {
            "all_of": [
              [
                "Green Park"
              ],
              [
                "exit"
              ],
              [
                "lift",
                "lifts"
              ]
            ]
          }
        ]
      }
    }
  },
  "proxy": false,
  "fixed_ip": false,
  "possibility_of_env_change": "medium"
}
