{
  "id": "consumption-ginger_ale_note",
  "snapshot": "chrome",
  "category": "consumption",
  "difficulty": "medium",
  "instruction": "I'm looking for a ginger ale that's less sweet, has a noticeable ginger flavor, and tastes good on its own rather than just as a mixer. Check the OneStopShop reviews and tell me if this one fits. Write only `yes` or `no` in `onestopshop_note.txt` on the Desktop.",
  "source": "WebArena self-hosted OneStopShop service",
  "gt_steps": [
    "Review the customer reviews on the already-open Q Mixers Premium Ginger Ale product page.",
    "Determine that the standard answer is `yes` because the reviews support the stated preferences.",
    "Open Notepad.",
    "Enter only `yes`.",
    "Save the file as `onestopshop_note.txt` on the Desktop."
  ],
  "config": [
    {
      "type": "execute",
      "parameters": {
        "command": "powershell -NoProfile -Command \"$p=Join-Path $env:USERPROFILE 'Desktop\\onestopshop_note.txt'; if(Test-Path $p){Remove-Item $p -Force}\"",
        "shell": true
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "cmd",
          "/c",
          "start chrome http://host.docker.internal:7770/q-mixers-premium-ginger-ale-real-ingredients-less-sweet-6-7-fl-oz-24-bottles.html"
        ]
      }
    }
  ],
  "trajectory": "trajectories\\",
  "related_apps": [
    "chrome",
    "notepad"
  ],
  "evaluator": {
    "func": "check_text_points",
    "result": {
      "type": "vm_command_line",
      "command": "powershell -NoProfile -Command \"$p=Join-Path $env:USERPROFILE 'Desktop\\onestopshop_note.txt'; if(Test-Path $p){$v=(Get-Content $p -Raw).Trim(); if($v -ieq 'yes'){Write-Output 'EXACT_YES'}}\"",
      "shell": true
    },
    "expected": {
      "type": "rule",
      "rules": {
        "ignore_case": false,
        "points": [
          [
            "EXACT_YES"
          ]
        ]
      }
    }
  },
  "proxy": false,
  "fixed_ip": false,
  "possibility_of_env_change": "low"
}
