{
  "id": "consumption-ginger_ale_note",
  "snapshot": "chrome",
  "category": "consumption",
  "difficulty": "medium",
  "instruction": "Use the OneStopShop customer reviews to decide whether this ginger ale fits these preferences: less sweet, noticeable ginger flavor, and good on its own rather than only as a mixer. Write only `yes` or `no` in `onestopshop_note.txt` on the Desktop.",
  "source": "WebArena self-hosted OneStopShop service",
  "gt_steps": [
    "Open the Q Mixers Premium Ginger Ale product page on the self-hosted shopping site.",
    "Read the customer reviews.",
    "Determine that the product matches the stated preferences with the standard answer `yes`.",
    "Open Notepad.",
    "Create `onestopshop_note.txt` on the Desktop.",
    "Enter only `yes` in the file.",
    "Save `onestopshop_note.txt`."
  ],
  "config": [
    {
      "type": "execute",
      "parameters": {
        "command": "powershell -NoProfile -Command \"$p=Join-Path $env:USERPROFILE 'Desktop\\onestopshop_note.txt'; if(Test-Path $p){Remove-Item $p -Force}\"",
        "shell": true
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "cmd",
          "/c",
          "start chrome http://host.docker.internal:7770/q-mixers-premium-ginger-ale-real-ingredients-less-sweet-6-7-fl-oz-24-bottles.html"
        ]
      }
    }
  ],
  "trajectory": "trajectories\\",
  "related_apps": [
    "chrome",
    "notepad"
  ],
  "evaluator": {
    "func": "check_text_points",
    "result": {
      "type": "vm_command_line",
      "command": "powershell -NoProfile -Command \"$p=Join-Path $env:USERPROFILE 'Desktop\\onestopshop_note.txt'; if(Test-Path $p){Get-Content $p -Raw}\"",
      "shell": true
    },
    "expected": {
      "type": "rule",
      "rules": {
        "ignore_case": true,
        "points": [
          [
            "yes"
          ]
        ]
      }
    }
  },
  "proxy": false,
  "fixed_ip": false,
  "possibility_of_env_change": "low"
}
