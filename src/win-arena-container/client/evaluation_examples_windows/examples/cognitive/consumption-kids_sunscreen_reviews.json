{
  "id": "consumption-kids_sunscreen_reviews",
  "user_group": "cognitive",
  "subgroup_ids": ["C-S1", "C-S3"],
  "category": "consumption",
  "need_ids": [
    "C5",
    "C6"
  ],
  "difficulty": "hard",
  "instruction": "Find a kids sunscreen that is SPF 50, mineral, sold as a foam twin pack, and whose customer reviews support that it does not sting and does not feel sticky. Add the matching product to the cart.",
  "source": "http://host.docker.internal:7770",
  "gt_steps": [
    "Open the self-hosted shopping website and search for kids sunscreen.",
    "Use product details to narrow to SPF 50 mineral foam twin packs.",
    "Check customer reviews for non-stinging and non-sticky feedback.",
    "Identify the Banana Boat Kids Vanishing Color mineral sunscreen foam twin pack as the matching product.",
    "Add the matching product to the shopping cart."
  ],
  "config": [
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    },
    {
      "type": "sleep",
      "parameters": {
        "seconds": 1
      }
    },
    {
      "type": "reset_shopping_cart",
      "parameters": {}
    },
    {
      "type": "chrome_open_tabs",
      "parameters": {
        "urls_to_open": [
          "http://host.docker.internal:7770"
        ]
      }
    }
  ],
  "related_apps": [
    "chrome"
  ],
  "evaluator": {
    "func": "is_page_contains_items",
    "result": {
      "type": "page_info",
      "url": "http://host.docker.internal:7770/checkout/cart/",
      "load_state": "networkidle"
    },
    "expected": {
      "type": "rule",
      "rules": {
        "items": [
          "B08Q3S3SNF"
        ]
      }
    }
  },
  "proxy": false,
  "possibility_of_env_change": "low"
}
